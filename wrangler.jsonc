{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guia-do-proprietario-portal",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-08-20",
  "vars": {
    "VERIFICACAO_PUBLIC_INTAKE_ENABLED": "true",
    "PUBLIC_VERIFICACAO_CHECKOUT_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "PDF_CASA_BANHO_DB",
      "database_name": "guia-proprietario-pdf-casa-banho",
      "database_id": "0035dea4-9613-4933-b7b4-9f926bf452fe",
      "migrations_dir": "migrations/pdf-casa-banho"
    },
    {
      "binding": "KIT_JANELAS_DB",
      "database_name": "guia-proprietario-kit-janelas",
      "database_id": "32fe7615-5bf4-427a-9ea0-7c4c5546497d",
      "migrations_dir": "migrations/kit-janelas"
    },
    {
      "binding": "KIT_ESTUDANTE_DB",
      "database_name": "guia-proprietario-kit-estudante",
      "database_id": "4a664d7b-760b-443f-8c8a-a40467474bdf"
    },
    {
      "binding": "VERIFICACAO_ANUNCIO_DB",
      "database_name": "guia-proprietario-verificacao-anuncio",
      "database_id": "d5428dbe-363f-4556-a7fe-4b7494be630f"
    },
    {
      "binding": "CONSENT_ARCHIVE_DB",
      "database_name": "guia-proprietario-consentimentos",
      "database_id": "4fcb7ecd-7281-4e65-9c3f-bf30b0feb0b7",
      "migrations_dir": "migrations/consent-archive"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VERIFICACAO_ANUNCIO_UPLOADS",
      "bucket_name": "guia-proprietario-verificacao-anuncio"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "VERIFICACAO_ANUNCIO_QUEUE",
        "queue": "verificacao-anuncio"
      }
    ]
  }
}
