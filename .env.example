PUBLIC_META_PIXEL_ID=
PUBLIC_LEAD_FORMS_ENABLED=true
# O ID do Pixel é público. Nunca guardar tokens da API ou do ESP nesta variável.

# Segredo. Configurar apenas na Cloudflare e nunca guardar o valor neste ficheiro.
SENDER_API_TOKEN=

# Email transacional da Verificação de Anúncio. O domínio do remetente tem de estar validado no Sender.
SENDER_TRANSACTIONAL_FROM_EMAIL=geral@guiadoproprietario.pt
SENDER_TRANSACTIONAL_FROM_NAME=Guia do Proprietário

# Benchmark da pesquisa visual. Ativar apenas os fornecedores efetivamente configurados.
GOOGLE_CLOUD_VISION_API_KEY=
TINEYE_API_KEY=

# IA da Verificação de Anúncio. Os modelos são variáveis para permitir o benchmark sem alterar código.
OPENAI_API_KEY=
VERIFICACAO_EXTRACTION_MODEL=gpt-5.4-mini
VERIFICACAO_CLASSIFICATION_MODEL=gpt-5.4-mini

# Segredo usado apenas para limitar pedidos e proteger identificadores técnicos.
# O token privado de cada verificação é gerado pelo webhook de pagamento e nunca é guardado em claro.
VERIFICACAO_ACCESS_SECRET=

# Pagamento único da Verificação de Anúncio. Configurar apenas na Cloudflare.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=price_1U9truFOwu52zlwGL2wlf4OX
SITE_URL=https://guiadoproprietario.pt
# Só ativar depois de Stripe, D1, R2, Queue e webhook estarem configurados e testados.
PUBLIC_VERIFICACAO_CHECKOUT_ENABLED=false

# Identificadores públicos dos grupos configurados no Sender.
SENDER_GROUP_TESTE=dPlrkn
SENDER_GROUP_GUIA_PARCEIROS=aKBm4l
SENDER_GROUP_GUIA_VENDER_CASA=dJAl59
SENDER_GROUP_MARKETING=egK8WG
SENDER_GROUP_LIMPEZA=bWv1LJ
# Opcional. Se ficar vazio, a função encontra o grupo pelo nome exato no Sender.
SENDER_GROUP_KIT_ESTUDANTE=

# Segredos do Kit Estudante. Configurar apenas na Cloudflare.
SESSION_SECRET=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=
# Versão explícita da Graph API, por exemplo v25.0, definida no momento de ativar o webhook.
META_GRAPH_VERSION=

# Segredo Bearer do endpoint POST /api/render-social-card.
# Configurar como secret no projeto Cloudflare Pages e usar o mesmo valor apenas no Make.
SOCIAL_CARD_RENDERER_SECRET=

# Gate determinístico do deployment Cloudflare Pages.
# CLOUDFLARE_API_TOKEN deve ser um secret com permissão Account > Cloudflare Pages > Edit.
# Nunca guardar o valor real no repositório nem no Make.
CLOUDFLARE_API_TOKEN=
# Account ID da conta Cloudflare que contém o projeto Pages.
CLOUDFLARE_ACCOUNT_ID=
# Nome exato do projeto Cloudflare Pages do portal.
CLOUDFLARE_PAGES_PROJECT=guia-do-proprietario-portal
