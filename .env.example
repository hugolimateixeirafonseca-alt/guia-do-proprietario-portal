PUBLIC_META_PIXEL_ID=
PUBLIC_LEAD_FORMS_ENABLED=true
PUBLIC_PARTNER_CONSENT_ENABLED=false
# O ID do Pixel é público. Nunca guardar tokens da API ou do ESP nesta variável.

# Segredo. Configurar apenas na Cloudflare e nunca guardar o valor neste ficheiro.
SENDER_API_TOKEN=

# Identificadores públicos dos grupos configurados no Sender.
SENDER_GROUP_TESTE=dPlrkn
SENDER_GROUP_GUIA_PARCEIROS=aKBm4l
SENDER_GROUP_GUIA_VENDER_CASA=dJAl59
SENDER_GROUP_NEWSLETTER=eEvG4m

# Ativar apenas depois de existir pelo menos um parceiro identificado em /parceiros/.
PARTNER_CONSENT_ENABLED=false
