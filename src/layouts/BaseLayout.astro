---
import "../styles/global.css";
import { site, pilares } from "../config";
import Marca from "../components/Marca.astro";

interface Props {
  titulo?: string;
  descricao?: string;
  canonical?: string;
  tipo?: "website" | "article";
  imagemOg?: string;
}

const {
  titulo = site.nome,
  descricao = site.descricao,
  canonical = new URL(Astro.url.pathname, site.dominio).toString(),
  tipo = "website",
  imagemOg
} = Astro.props;
const tituloCompleto = titulo === site.nome ? titulo : `${titulo} | ${site.nome}`;
const utilitaria = ["/", "/sobre/", "/metodologia/", "/privacidade/", "/termos/", "/ligacoes/", "/glossario/", "/pesquisa/", "/404/"].includes(Astro.url.pathname);
const ogPath = utilitaria ? "/og-1200x630.png" : `/og${Astro.url.pathname === "/" ? "/index/" : Astro.url.pathname}index.png`;
const imagemOgFinal = imagemOg || new URL(ogPath, site.dominio).toString();
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.nome,
  url: site.dominio
};

const linksNavegacao = [
  ...pilares.map((pilar) => ({ nome: pilar.nome, url: `/${pilar.slug}/` })),
  { nome: "Calendário", url: "/calendario/" },
  { nome: "Novidades", url: "/novidades/" },
  { nome: "Simuladores", url: "/simuladores/" }
];
---
<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={descricao} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagemOgFinal} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{tituloCompleto}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>
    <header class="site-header">
      <a class="brand" href="/"><Marca /><span>Guia do Proprietário</span></a>
      <nav class="desktop-nav" aria-label="Navegação principal">
        {linksNavegacao.map((link) => <a href={link.url}>{link.nome}</a>)}
      </nav>
      <a class="search-link" href="/pesquisa/" aria-label="Pesquisar" title="Pesquisar">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
        <span class="visually-hidden">Pesquisar</span>
      </a>
      <details class="mobile-menu">
        <summary>Explorar</summary>
        <nav aria-label="Navegação móvel">
          {linksNavegacao.map((link) => <a href={link.url}>{link.nome}</a>)}
        </nav>
      </details>
    </header>
    <main id="conteudo"><slot /></main>
    <footer class="site-footer">
      <div><a class="brand footer-brand" href="/"><Marca /><span>Guia do Proprietário</span></a><p>Informação prática para proprietários em Portugal.</p></div>
      <nav aria-label="Informação"><a href="/sobre/">Sobre</a><a href="/metodologia/">Metodologia</a><a href="/glossario/">Glossário</a><a href="/privacidade/">Privacidade</a><a href="/termos/">Termos</a><a href="/rss.xml">RSS</a></nav>
      <small>© {new Date().getFullYear()} Guia do Proprietário. Conteúdo informativo, sujeito a revisão.</small>
    </footer>
  </body>
</html>
