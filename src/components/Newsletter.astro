---
import { NEWSLETTER_CONSENT_VERSION } from "../data/consent";
---

<section class="newsletter" id="newsletter-form" aria-labelledby="newsletter-title">
  <div>
    <p class="eyebrow">Newsletter</p>
    <h2 id="newsletter-title">Receba o essencial sobre casa, sem ruído</h2>
    <p>Novos guias, prazos importantes e conselhos práticos para comprar, vender, arrendar, procurar ou cuidar de uma casa.</p>
  </div>
  <form class="newsletter-form" novalidate>
    <label class="newsletter-email-label" for="newsletter-email">Email</label>
    <div class="newsletter-email-row">
      <input id="newsletter-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="nome@email.pt" required />
      <button type="submit">Subscrever</button>
    </div>
    <label class="newsletter-consent newsletter-consent-required">
      <input type="checkbox" name="newsletter_consent" required aria-describedby="newsletter-consent-error" />
      <span><strong>Newsletter do Guia</strong> Quero receber por email guias, prazos importantes, novidades e conselhos práticos sobre casa. Li a <a href="/privacidade/">Política de Privacidade</a> e posso cancelar a qualquer momento.</span>
    </label>
    <p class="newsletter-error" id="newsletter-consent-error" hidden>É preciso aceitar a newsletter para subscrever.</p>
    <label class="newsletter-consent newsletter-consent-optional">
      <input type="checkbox" name="advertising_consent" />
      <span><strong>Publicidade e ofertas <em>Opcional</em></strong> Quero também receber publicidade, ofertas e conteúdos patrocinados de empresas terceiras selecionadas pelo Guia do Proprietário. As mensagens são enviadas pelo Guia e o meu email não é partilhado com os anunciantes.</span>
    </label>
    <small>As duas escolhas são independentes e podem ser retiradas a qualquer momento.</small>
    <p class="newsletter-status" role="status" aria-live="polite"></p>
  </form>
</section>

<script is:inline define:vars={{ NEWSLETTER_CONSENT_VERSION }}>
  document.querySelectorAll(".newsletter-form").forEach((form) => {
    const email = form.querySelector('input[type="email"]');
    const newsletterConsent = form.querySelector('input[name="newsletter_consent"]');
    const advertisingConsent = form.querySelector('input[name="advertising_consent"]');
    const consentLabel = form.querySelector(".newsletter-consent-required");
    const error = form.querySelector(".newsletter-error");
    const status = form.querySelector(".newsletter-status");
    const button = form.querySelector('button[type="submit"]');

    newsletterConsent.addEventListener("change", () => {
      if (newsletterConsent.checked) {
        consentLabel.classList.remove("erro");
        error.hidden = true;
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      status.textContent = "";

      if (!newsletterConsent.checked) {
        consentLabel.classList.add("erro");
        error.hidden = false;
        newsletterConsent.focus();
        return;
      }
      if (!email.checkValidity()) {
        email.reportValidity();
        return;
      }

      button.disabled = true;
      button.textContent = "A enviar...";
      const eventId = globalThis.crypto?.randomUUID?.() || `newsletter-${Date.now()}`;

      try {
        const response = await fetch("/api/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: email.value.trim(),
            consent1: true,
            consent2: advertisingConsent.checked,
            consentVersion: NEWSLETTER_CONSENT_VERSION,
            source: "newsletter",
            pageUrl: location.href,
            eventId
          })
        });
        if (!response.ok) throw new Error("subscribe_failed");
        if (window.fbq) window.fbq("track", "Lead", { content_name: "newsletter" }, { eventID: eventId });
        form.reset();
        button.classList.add("is-complete");
        button.textContent = "Subscrição concluída";
        status.textContent = "Subscrição concluída. Já faz parte da Newsletter do Guia do Proprietário.";
      } catch {
        status.textContent = "A subscrição ainda não está disponível. Tente novamente mais tarde.";
        button.disabled = false;
        button.textContent = "Subscrever";
      }
    });
  });
</script>
