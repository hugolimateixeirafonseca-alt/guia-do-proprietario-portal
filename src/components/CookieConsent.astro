---
const OFFICIAL_META_PIXEL_ID = "1394294186173855";
const configuredMetaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID || "";
const metaPixelId = /^\d{10,30}$/.test(configuredMetaPixelId)
  ? configuredMetaPixelId
  : OFFICIAL_META_PIXEL_ID;
---

<dialog class="cookie-banner" id="cookie-banner" aria-labelledby="cookie-title" aria-describedby="cookie-description" tabindex="-1">
  <div class="cookie-summary">
    <strong id="cookie-title">A sua escolha sobre cookies</strong>
    <p id="cookie-description">Podemos usar cookies e partilhar dados de medição com a Meta para perceber as visitas e os resultados das campanhas. Escolha se aceita esta medição. Pode recusar e continuar a usar o site.</p>
    <a href="/cookies/">Consultar a Política de Cookies</a>
  </div>

  <div class="cookie-options" id="cookie-options" hidden>
    <div class="cookie-option">
      <div><strong>Necessários</strong><span>Guardam a sua escolha e ajudam o site a funcionar.</span></div>
      <span class="cookie-always">Sempre ativos</span>
    </div>
    <label class="cookie-option">
      <div><strong>Medição</strong><span>Mede visitas e resultados de campanhas através do Meta Pixel e da API de Conversões, quando estiverem ativos.</span></div>
      <input id="cookie-measurement" type="checkbox" />
    </label>
  </div>

  <div class="cookie-actions">
    <button type="button" data-cookie-choice="all">Aceitar medição</button>
    <button type="button" data-cookie-choice="necessary">Recusar</button>
    <button type="button" class="cookie-customize" data-cookie-customize>Personalizar</button>
    <button type="button" class="cookie-save" data-cookie-save hidden>Guardar escolha</button>
  </div>
</dialog>

<script is:inline define:vars={{ metaPixelId }}>
  (() => {
    const COOKIE_NAME = "gp_cookie_preferences";
    const COOKIE_VERSION = "2026-09-01-1";
    const banner = document.getElementById("cookie-banner");
    const options = document.getElementById("cookie-options");
    const measurement = document.getElementById("cookie-measurement");
    const customize = banner?.querySelector("[data-cookie-customize]");
    const save = banner?.querySelector("[data-cookie-save]");

    if (!banner || !options || !measurement) return;

    const readPreferences = () => {
      const raw = document.cookie
        .split(";")
        .map((item) => item.trim())
        .find((item) => item.startsWith(`${COOKIE_NAME}=`))
        ?.slice(COOKIE_NAME.length + 1);
      if (!raw) return null;
      try {
        const parsed = JSON.parse(decodeURIComponent(raw));
        const savedAt = Date.parse(parsed.savedAt);
        return parsed.version === COOKIE_VERSION && typeof parsed.measurement === "boolean"
          && Number.isFinite(savedAt) && savedAt <= Date.now() + 300000
          && savedAt >= Date.now() - 15552000000 ? parsed : null;
      } catch {
        return null;
      }
    };

    let previousOverflow = "";
    const openConsent = () => {
      if (banner.open) return;
      previousOverflow = document.documentElement.style.overflow;
      banner.showModal();
      document.documentElement.style.overflow = "hidden";
      banner.focus();
    };
    const closeConsent = () => {
      if (!banner.open) return;
      banner.close();
      document.documentElement.style.overflow = previousOverflow;
    };
    // Escape e cliques no fundo não equivalem a uma escolha de consentimento.
    banner.addEventListener("cancel", (event) => event.preventDefault());

    const loadPixel = () => {
      if (!metaPixelId || window._pixelOn) return;
      window._pixelOn = true;
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
      n.push=n;n.loaded=!0;n.version="2.0";n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}
      (window,document,"script","https://connect.facebook.net/en_US/fbevents.js");
      window.fbq("init", metaPixelId);
      window.fbq("track", "PageView");
    };

    const savePreferences = (measurementAllowed) => {
      const pixelWasOn = Boolean(window._pixelOn);
      const value = encodeURIComponent(JSON.stringify({
        version: COOKIE_VERSION,
        necessary: true,
        measurement: measurementAllowed,
        savedAt: new Date().toISOString()
      }));
      const secure = location.protocol === "https:" ? "; Secure" : "";
      document.cookie = `${COOKIE_NAME}=${value}; Path=/; Max-Age=15552000; SameSite=Lax${secure}`;
      closeConsent();
      if (measurementAllowed) loadPixel();
      if (!measurementAllowed) {
        document.cookie = "_fbp=; Path=/; Max-Age=0; SameSite=Lax";
        document.cookie = "_fbc=; Path=/; Max-Age=0; SameSite=Lax";
        if (pixelWasOn) location.reload();
      }
    };

    banner.querySelector("[data-cookie-choice='all']")?.addEventListener("click", () => savePreferences(true));
    banner.querySelector("[data-cookie-choice='necessary']")?.addEventListener("click", () => savePreferences(false));
    customize?.addEventListener("click", () => {
      options.hidden = false;
      customize.hidden = true;
      save.hidden = false;
      measurement.focus();
    });
    save?.addEventListener("click", () => savePreferences(measurement.checked));

    document.querySelectorAll("[data-cookie-settings]").forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        const current = readPreferences();
        measurement.checked = current?.measurement === true;
        options.hidden = false;
        customize.hidden = true;
        save.hidden = false;
        openConsent();
        measurement.focus();
      });
    });

    const preferences = readPreferences();
    if (preferences?.measurement) loadPixel();
    // A informação legal continua acessível antes de escolher.
    const legalPage = ["/cookies", "/privacidade", "/politica-de-privacidade", "/termos"].includes(location.pathname.replace(/\/+$/, ""));
    if (!preferences && !legalPage) openConsent();
  })();
</script>

<style>
  .cookie-banner { position: fixed; inset: 0; width: min(560px, calc(100% - 32px)); max-height: calc(100dvh - 32px); overflow-y: auto; box-sizing: border-box; margin: auto; padding: 24px; display: grid; gap: 18px; border-radius: 12px; font-family: inherit; color: #102a31; background: #fffefa; border: 1px solid #b9c9c3; box-shadow: 0 18px 55px rgba(9, 34, 41, .24); }
  .cookie-banner::backdrop { background: rgba(9, 34, 41, .58); }
  .cookie-banner:not([open]), .cookie-options[hidden], .cookie-actions [hidden] { display: none; }
  .cookie-summary strong { display: block; margin-bottom: 5px; font-size: 17px; }
  .cookie-summary p { margin: 0; font-size: 13px; line-height: 1.5; }
  .cookie-summary a { display: inline-block; margin-top: 6px; color: #256b5c; font-size: 12px; font-weight: 750; }
  .cookie-options { display: grid; gap: 8px; }
  .cookie-option { padding: 11px 12px; display: grid; grid-template-columns: 1fr auto; gap: 20px; align-items: center; background: #f1f5f2; border: 1px solid #d6e0dc; }
  .cookie-option strong, .cookie-option span { display: block; }
  .cookie-option span { margin-top: 2px; color: #53656a; font-size: 11px; }
  .cookie-option input { width: 20px; height: 20px; accent-color: #256b5c; }
  .cookie-always { color: #256b5c !important; font-weight: 800; }
  .cookie-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; }
  .cookie-actions button { min-height: 44px; padding: 8px 14px; color: white; background: #256b5c; border: 2px solid #256b5c; border-radius: 4px; font: inherit; font-size: 13px; font-weight: 800; cursor: pointer; }
  .cookie-actions .cookie-customize { grid-column: 1 / -1; color: #256b5c; background: transparent; border-color: transparent; }
  .cookie-actions .cookie-save { grid-column: 1 / -1; }
  .cookie-actions button:hover, .cookie-actions button:focus-visible { outline: 3px solid rgba(37, 107, 92, .2); outline-offset: 2px; }
  @media (max-width: 650px) {
    .cookie-banner { width: calc(100% - 24px); max-height: calc(100dvh - 24px); padding: 20px; }
    .cookie-actions { grid-template-columns: 1fr; }
    .cookie-actions .cookie-save { grid-column: auto; }
    .cookie-actions button { width: 100%; }
  }
</style>
