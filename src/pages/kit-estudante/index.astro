-row input{min-width:0;padding:15px 16px;border:1px solid #aebfba;border-radius:4px;background:white}.form-row input:focus{outline:3px solid rgba(37,107,92,.18);border-color:#256b5c}.form-row button{min-height:52px;padding:0 22px;border:0;border-radius:4px;color:white;background:#256b5c;font-weight:850;cursor:pointer}.form-row button:hover{background:#174e43}.form-row button:disabled{opacity:.65;cursor:wait}.consent{margin-top:14px;display:grid;grid-template-columns:18px 1fr;gap:10px;align-items:start;color:#41545a;font-size:.78rem;line-height:1.48}.consent input{width:17px;height:17px;margin-top:2px;accent-color:#256b5c}.consent a{color:#24594f;font-weight:750}.form-note,.form-status,.field-error{margin:9px 0 0;font-size:.8rem}.form-note{color:#5f7075}.form-status,.field-error{color:#9a2f28;font-weight:700}.honeypot{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}.covers{position:relative;min-height:590px}.cover{position:absolute;width:57%;border-radius:10px;filter:drop-shadow(0 24px 34px rgba(16,42,49,.18))}.cover-one{left:2%;top:12%;transform:rotate(-6deg)}.cover-two{right:1%;top:1%;transform:rotate(6deg)}.cover-badge{position:absolute;left:50%;bottom:7%;transform:translateX(-50%);padding:11px 17px;border-radius:999px;color:white;background:#315f78;font-size:.84rem;font-weight:850;white-space:nowrap}.proof{background:white}.stats{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid #dce4e0}.stats div{padding:34px;text-align:center}.stats div+div{border-left:1px solid #dce4e0}.stats strong{display:block;color:#315f78;font-family:Georgia,"Times New Roman",serif;font-size:clamp(2.5rem,4vw,4.4rem);line-height:1}.stats span{display:block;margin-top:10px;color:#5f7075;font-size:.92rem}.section{padding:86px 0}.section.soft{background:#f6efe0}.section.dark{color:white;background:#102a31}.section-heading{max-width:790px;margin-bottom:40px}.section h2{font-family:Georgia,"Times New Roman",serif;font-