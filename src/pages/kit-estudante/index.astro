---
import KitEstudanteLayout from "../../layouts/KitEstudanteLayout.astro";
import { KIT_ESTUDANTE_CONSENT_TEXT, KIT_ESTUDANTE_CONSENT_VERSION } from "../../data/kit-estudante";
---
<KitEstudanteLayout
  titulo="Kit do Estudante Deslocado 2026 | Guia do Proprietário"
  descricao="Dois manuais gratuitos para pais de estudantes deslocados: verificação do quarto, custos, apoios, bolsas e IRS."
  imagemOg="/kit-estudante/kit-estudante-2026-og.webp"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Kit gratuito para pais · edição 2026</p>
        <h1>Estudar fora custa <em>5.500 €</em> por ano. Ou 2.600 €, se souber o que pedir.</h1>
        <p class="intro">Dois manuais para quem vai pagar o quarto do filho este ano. Um ajuda a evitar burlas e pagamentos errados. O outro mostra o custo real, os apoios disponíveis e os prazos que decidem tudo.</p>
        <form class="lead-form" novalidate data-consent-version={KIT_ESTUDANTE_CONSENT_VERSION}>
        <fieldset class="qualifier" data-relation-group>
          <legend>Qual destas opções descreve melhor a sua relação com o estudante?</legend>
          <label class="qualifier-option"><input type="radio" name="relacao" value="pai_mae_encarregado" required /><span>Sou pai, mãe ou encarregado de educação de um estudante do ensino superior</span></label>
          <label class="qualifier-option"><input type="radio" name="relacao" value="estudante" required /><span>Sou estudante</span></label>
          <label class="qualifier-option"><input type="radio" name="relacao" value="outro" required /><span>Outro</span></label>
        </fieldset>
        <p class="field-error" data-relation-error hidden>Escolha uma opção para continuar.</p>
        <div data-form-fields hidden>
          <div class="qualifier-grid" data-profile-fields>
            <label class="field-label" for="hero-cidade"><span data-city-question>Em que cidade vai estudar o seu filho/a?</span>
              <select id="hero-cidade" name="cidade" required>
                <option value="">Escolha uma opção</option>
                <option value="lisboa">Lisboa</option>
                <option value="porto">Porto</option>
                <option value="coimbra">Coimbra</option>
                <option value="braga">Braga</option>
                <option value="aveiro">Aveiro</option>
                <option value="evora">Évora</option>
                <option value="faro">Faro</option>
                <option value="outra">Outra</option>
              </select>
            </label>
            <label class="field-label" for="hero-fase"><span data-phase-question>Em que fase está a procura de alojamento?</span>
              <select id="hero-fase" name="fase" required>
                <option value="">Escolha uma opção</option>
                <option value="procura" data-parent-copy="Ainda estamos à procura" data-student-copy="Ainda estou à procura">Ainda estamos à procura</option>
                <option value="encontrou" data-parent-copy="Já encontrámos alojamento" data-student-copy="Já encontrei alojamento">Já encontrámos alojamento</option>
                <option value="tratado">Já está tudo tratado</option>
              </select>
            </label>
          </div>
          <p class="field-error" data-profile-error hidden>Indique a cidade e a fase da procura.</p>

          <label class="field-label" for="hero-email">O seu email</label>
          <div class="form-row">
            <input id="hero-email" type="email" name="email" placeholder="nome@exemplo.pt" required autocomplete="email" inputmode="email" />
            <button type="submit">Receber os dois manuais</button>
          </div>
          <p class="field-error" data-email-error hidden>Introduza um endereço de email válido.</p>
          <label class="honeypot" aria-hidden="true">Website<input name="website_confirm_url_x9" tabindex="-1" autocomplete="new-password" data-honeypot /></label>
          <label class="consent">
            <input type="checkbox" name="consent" required />
            <span>{KIT_ESTUDANTE_CONSENT_TEXT} Consulte a <a href="/privacidade/">Política de Privacidade</a>.</span>
          </label>
          <p class="field-error" data-consent-error hidden>Aceite esta opção para receber os manuais.</p>
          <p class="form-note">Envio imediato. Sem custo. Pode cancelar quando quiser.</p>
          <p class="form-status" aria-live="polite"></p>
        </div>
      </form>
      </div>
      <div class="covers" aria-label="Capas dos dois manuais incluídos no kit">
        <img class="cover cover-one" src="/kit-estudante/checklist-dos-pais-2026.webp" width="720" height="1018" alt="Capa do manual Checklist dos Pais" />
        <img class="cover cover-two" src="/kit-estudante/o-custo-real-estudante-deslocado-2026.webp" width="720" height="1018" alt="Capa do manual O custo real de ter um filho a estudar fora" />
        <span class="cover-badge">38 páginas · 2 manuais · edição 2026</span>
      </div>
    </div>
  </section>

  <section class="proof" aria-label="Três números importantes">
    <div class="wrap stats">
      <div><strong>2.900 €</strong><span>Diferença potencial no mesmo ano entre conhecer os apoios e ignorá-los.</span></div>
      <div><strong>400 €</strong><span>Máximo anual indicado no guia para a dedução de rendas de estudante deslocado.</span></div>
      <div><strong>31 Out.</strong><span>Prazo destacado no kit para o apoio ao alojamento de não bolseiros.</span></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">O que recebe</p>
        <h2>Um manual reduz o risco. O outro reduz a conta.</h2>
      </div>
      <div class="manual-grid">
        <article class="manual-card">
          <img src="/kit-estudante/checklist-dos-pais-2026.webp" width="360" height="509" loading="lazy" alt="Capa do Manual 1, Checklist dos Pais" />
          <div><p class="meta">Manual 1 · 20 páginas · 27 verificações</p><h3>Checklist dos Pais</h3><p>Antes de pagar sinal, caução ou primeira renda, confirme que o quarto existe, quem o está a arrendar e o que deve ficar por escrito.</p></div>
        </article>
        <article class="manual-card">
          <img src="/kit-estudante/o-custo-real-estudante-deslocado-2026.webp" width="360" height="509" loading="lazy" alt="Capa do Manual 2, O custo real" />
          <div><p class="meta">Manual 2 · 18 páginas · edição 2026</p><h3>O custo real</h3><p>Compare preços por cidade, residências, bolsas, apoios ao alojamento, IRS e os prazos mais importantes do ano letivo.</p></div>
        </article>
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="wrap">
      <div class="section-heading"><p class="eyebrow">Por dentro do kit</p><h2>Informação concreta para decidir antes de pagar.</h2></div>
      <div class="inside-grid">
        <div><h3>Checklist dos Pais</h3><ul>
          <li>As três perguntas que revelam rapidamente se o senhorio é sério.</li>
          <li>Como confirmar que o quarto existe e quem está a arrendá-lo.</li>
          <li>O que verificar antes de pagar sinal, caução ou primeira renda.</li>
          <li>Uma checklist final de 27 pontos para imprimir.</li>
        </ul></div>
        <div><h3>O custo real</h3><ul>
          <li>Quanto custa um quarto em várias cidades portuguesas.</li>
          <li>Residências universitárias, bolsas e complementos de alojamento.</li>
          <li>Dedução em IRS e condições para não a perder.</li>
          <li>Calendário com os principais prazos do ano letivo.</li>
        </ul></div>
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="wrap credibility">
      <p class="eyebrow">Porque é diferente</p>
      <h2>Fontes identificadas. Datas à vista. Decisões mais seguras.</h2>
      <p>O kit organiza números, prazos e condições, e indica as fontes e as datas de verificação para confirmar cada regra antes de decidir.</p>
      <div class="chips"><span>INE</span><span>DGES</span><span>Portal das Finanças</span><span>Fontes oficiais indicadas nos manuais</span></div>
    </div>
  </section>

  <section class="section calendar">
    <div class="wrap">
      <div class="section-heading"><p class="eyebrow">O calendário que decide tudo</p><h2>Quatro datas para não descobrir tarde demais.</h2></div>
      <div class="timeline">
        <div><strong>Maio e junho</strong><span>Candidaturas a residência.</span></div>
        <div><strong>14 de agosto</strong><span>Abertura da candidatura à bolsa.</span></div>
        <div><strong>Final de agosto</strong><span>Janela de residência para novos estudantes.</span></div>
        <div><strong>31 de outubro</strong><span>Prazo indicado para o complemento de não bolseiros.</span></div>
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="wrap faq">
      <div class="section-heading"><p class="eyebrow">Perguntas frequentes</p><h2>Antes de pedir o kit.</h2></div>
      <details open><summary>É mesmo gratuito?</summary><p>Sim. Os dois manuais são enviados gratuitamente para o email indicado.</p></details>
      <details><summary>Serve se o meu filho já arrendou?</summary><p>Sim. O segundo manual continua a ser útil para rever apoios, prazos e a dedução em IRS, mesmo depois de o contrato estar feito.</p></details>
      <details><summary>Isto é aconselhamento jurídico ou fiscal?</summary><p>Não. É informação organizada com indicação das fontes para confirmar cada regra e cada valor antes de decidir.</p></details>
      <details><summary>Vão encher-me a caixa de correio?</summary><p>Não. Recebe os manuais e, depois, informação relacionada com pouca frequência. Pode cancelar em qualquer email.</p></details>
    </div>
  </section>

  <section class="section final-cta">
    <div class="wrap final-inner">
      <p class="eyebrow">Receba agora</p>
      <h2>Leia estas 38 páginas antes de pagar o quarto.</h2>
      <form class="lead-form" novalidate data-consent-version={KIT_ESTUDANTE_CONSENT_VERSION}>
        <fieldset class="qualifier" data-relation-group>
          <legend>Qual destas opções descreve melhor a sua relação com o estudante?</legend>
          <label class="qualifier-option"><input type="radio" name="relacao" value="pai_mae_encarregado" required /><span>Sou pai, mãe ou encarregado de educação de um estudante do ensino superior</span></label>
          <label class="qualifier-option"><input type="radio" name="relacao" value="estudante" required /><span>Sou estudante</span></label>
          <label class="qualifier-option"><input type="radio" name="relacao" value="outro" required /><span>Outro</span></label>
        </fieldset>
        <p class="field-error" data-relation-error hidden>Escolha uma opção para continuar.</p>
        <div data-form-fields hidden>
          <div class="qualifier-grid" data-profile-fields>
            <label class="field-label" for="final-cidade"><span data-city-question>Em que cidade vai estudar o seu filho/a?</span>
              <select id="final-cidade" name="cidade" required>
                <option value="">Escolha uma opção</option>
                <option value="lisboa">Lisboa</option>
                <option value="porto">Porto</option>
                <option value="coimbra">Coimbra</option>
                <option value="braga">Braga</option>
                <option value="aveiro">Aveiro</option>
                <option value="evora">Évora</option>
                <option value="faro">Faro</option>
                <option value="outra">Outra</option>
              </select>
            </label>
            <label class="field-label" for="final-fase"><span data-phase-question>Em que fase está a procura de alojamento?</span>
              <select id="final-fase" name="fase" required>
                <option value="">Escolha uma opção</option>
                <option value="procura" data-parent-copy="Ainda estamos à procura" data-student-copy="Ainda estou à procura">Ainda estamos à procura</option>
                <option value="encontrou" data-parent-copy="Já encontrámos alojamento" data-student-copy="Já encontrei alojamento">Já encontrámos alojamento</option>
                <option value="tratado">Já está tudo tratado</option>
              </select>
            </label>
          </div>
          <p class="field-error" data-profile-error hidden>Indique a cidade e a fase da procura.</p>

          <label class="field-label" for="final-email">O seu email</label>
          <div class="form-row">
            <input id="final-email" type="email" name="email" placeholder="nome@exemplo.pt" required autocomplete="email" inputmode="email" />
            <button type="submit">Receber os dois manuais</button>
          </div>
          <p class="field-error" data-email-error hidden>Introduza um endereço de email válido.</p>
          <label class="honeypot" aria-hidden="true">Website<input name="website_confirm_url_x9" tabindex="-1" autocomplete="new-password" data-honeypot /></label>
          <label class="consent">
            <input type="checkbox" name="consent" required />
            <span>{KIT_ESTUDANTE_CONSENT_TEXT} Consulte a <a href="/privacidade/">Política de Privacidade</a>.</span>
          </label>
          <p class="field-error" data-consent-error hidden>Aceite esta opção para receber os manuais.</p>
          
          <p class="form-status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>

  <footer class="kit-footer"><div class="wrap"><span>© 2026 Guia do Proprietário</span><nav aria-label="Informação legal"><a href="/privacidade/">Privacidade</a><a href="/termos/">Termos</a><a href="/parceiros/">Parceiros e fornecedores</a><a href="#cookie-settings" data-cookie-settings>Definições de cookies</a></nav></div></footer>
</KitEstudanteLayout>

<script>
  const sources = new Set(["meta", "artigo", "grupo", "pdf", "direto"]);
  const params = new URLSearchParams(location.search);
  const source = sources.has(params.get("src") || "") ? params.get("src") : "direto";

  const measurementAllowed = () => {
    const item = document.cookie.split(";").map((value) => value.trim()).find((value) => value.startsWith("gp_cookie_preferences="));
    if (!item) return false;
    try { return JSON.parse(decodeURIComponent(item.split("=").slice(1).join("="))).measurement === true; } catch { return false; }
  };

  document.querySelectorAll<HTMLFormElement>(".lead-form").forEach((form) => {
    const relationInputs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="relacao"]'));
    const formFields = form.querySelector<HTMLElement>("[data-form-fields]")!;
    const profileFields = form.querySelector<HTMLElement>("[data-profile-fields]")!;
    const cityQuestion = form.querySelector<HTMLElement>("[data-city-question]")!;
    const phaseQuestion = form.querySelector<HTMLElement>("[data-phase-question]")!;
    const relationError = form.querySelector<HTMLElement>("[data-relation-error]")!;
    const profileError = form.querySelector<HTMLElement>("[data-profile-error]")!;
    const city = form.elements.namedItem("cidade") as HTMLSelectElement;
    const phase = form.elements.namedItem("fase") as HTMLSelectElement;
    const email = form.elements.namedItem("email") as HTMLInputElement;
    const consent = form.elements.namedItem("consent") as HTMLInputElement;
    const honeypot = form.querySelector<HTMLInputElement>("[data-honeypot]")!;
    const button = form.querySelector<HTMLButtonElement>("button[type='submit']")!;
    const status = form.querySelector<HTMLElement>(".form-status")!;
    const emailError = form.querySelector<HTMLElement>("[data-email-error]")!;
    const consentError = form.querySelector<HTMLElement>("[data-consent-error]")!;

    const selectedRelation = () => relationInputs.find((input) => input.checked)?.value || "";
    const setRelationState = () => {
      const relation = selectedRelation();
      const asksProfile = relation === "pai_mae_encarregado" || relation === "estudante";
      formFields.hidden = !relation;
      profileFields.hidden = !asksProfile;
      relationError.hidden = Boolean(relation);
      for (const control of [email, consent, honeypot]) control.disabled = !relation;
      for (const control of [city, phase]) {
        control.disabled = !asksProfile;
        control.required = asksProfile;
      }
      if (!asksProfile) {
        city.value = "";
        phase.value = "";
        profileError.hidden = true;
      }
      const isStudent = relation === "estudante";
      cityQuestion.textContent = isStudent ? "Em que cidade vai estudar?" : "Em que cidade vai estudar o seu filho/a?";
      phaseQuestion.textContent = isStudent ? "Em que fase está a sua procura de alojamento?" : "Em que fase está a procura de alojamento?";
      phase.querySelectorAll<HTMLOptionElement>("option[data-parent-copy]").forEach((option) => {
        option.textContent = isStudent ? option.dataset.studentCopy || "" : option.dataset.parentCopy || "";
      });
      status.textContent = "";
    };

    for (const input of relationInputs) input.addEventListener("change", setRelationState);
    city.addEventListener("change", () => { profileError.hidden = true; city.removeAttribute("aria-invalid"); });
    phase.addEventListener("change", () => { profileError.hidden = true; phase.removeAttribute("aria-invalid"); });
    email.addEventListener("input", () => { emailError.hidden = true; email.removeAttribute("aria-invalid"); });
    consent.addEventListener("change", () => { consentError.hidden = true; consent.removeAttribute("aria-invalid"); });
    setRelationState();

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const relation = selectedRelation();
      if (!relation) {
        relationError.hidden = false;
        relationInputs[0]?.focus();
        return;
      }
      const asksProfile = relation === "pai_mae_encarregado" || relation === "estudante";
      const profileValid = !asksProfile || (Boolean(city.value) && Boolean(phase.value));
      profileError.hidden = profileValid;
      city.toggleAttribute("aria-invalid", asksProfile && !city.value);
      phase.toggleAttribute("aria-invalid", asksProfile && !phase.value);
      emailError.hidden = email.validity.valid;
      consentError.hidden = consent.checked;
      email.toggleAttribute("aria-invalid", !email.validity.valid);
      consent.toggleAttribute("aria-invalid", !consent.checked);

      if (!profileValid) {
        (!city.value ? city : phase).focus();
        return;
      }
      if (!email.validity.valid) { email.focus(); return; }
      if (!consent.checked) { consent.focus(); return; }

      button.disabled = true;
      button.textContent = "A enviar…";
      status.textContent = "";
      const eventId = crypto.randomUUID();

      try {
        const response = await fetch("/api/kit-estudante/lead", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: email.value,
            consent: true,
            consentVersion: form.dataset.consentVersion,
            origem: source,
            relacao: relation,
            cidade: city.value,
            fase: phase.value,
            company: honeypot.value,
            eventId
          })
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || "submit_failed");
        const fbq = (window as Window & { fbq?: (...args: unknown[]) => void }).fbq;
        if (measurementAllowed() && typeof fbq === "function") {
          fbq("track", "Lead", {
            content_name: "kit_estudante_2026",
            lead_type: relation,
            cidade: city.value,
            fase: phase.value
          }, { eventID: eventId });
        }
        location.assign(result.redirect || "/kit-estudante/obrigado/");
      } catch {
        status.textContent = "Não foi possível enviar agora. Tente novamente dentro de instantes.";
        button.disabled = false;
        button.textContent = "Receber os dois manuais";
      }
    });
  });
</script>

<style>
