---
import Squeeze from "../../layouts/Squeeze.astro";
import Marca from "../../components/Marca.astro";
import SeguroVidaCta from "../../components/SeguroVidaCta.astro";
import { SEGURO_VIDA_DESTINOS } from "../../data/seguro-vida";
import "../../styles/seguro-vida.css";
const destino = SEGURO_VIDA_DESTINOS.landing;
const titulo = "Está a pagar demasiado pelo seguro de vida? Peça uma simulação gratuita | Guia do Proprietário";
const descricao = "Ponha o preço do seguro de vida do crédito habitação à prova. Peça a sua simulação gratuita e descubra se pode baixar este custo da casa.";
const perguntas = [
  { pergunta: "Tenho o seguro no banco. Também posso pedir?", resposta: "Sim. Pode procurar uma alternativa mantendo o crédito. O banco deve aceitar um seguro com garantias equivalentes às exigidas. Confirme o eventual efeito no spread ou noutros benefícios para saber quanto pode poupar no conjunto." },
  { pergunta: "Tenho de pagar ou de mudar de seguro?", resposta: "O pedido de simulação é gratuito e sem compromisso. Conheça a proposta e decida depois se quer avançar. O seu seguro atual não muda por pedir informação." },
  { pergunta: "O que acontece depois do clique?", resposta: "Segue para a página do parceiro, preenche o pedido e solicita contacto telefónico. É nesse contacto que pode esclarecer o preço e as condições para o seu caso." },
  { pergunta: "Quanto posso poupar?", resposta: "A diferença depende do seguro atual, da nova proposta e das condições do crédito. Peça a simulação para ter os valores à frente e perceber se a mudança compensa. Compare também as coberturas e a evolução prevista do preço." },
];
---
<Squeeze titulo={titulo} descricao={descricao} imagemOg="/imagens/artigos/vender-casa-com-credito-por-pagar.webp" robots="noindex,follow">
  <a class="sv-skip" href="#conteudo">Saltar para o conteúdo</a>
  <header class="sv-header"><div class="sv-container sv-header-inner">
    <a class="sv-brand" href="#conteudo" aria-label="Guia do Proprietário"><Marca /><span>Guia do<br />Proprietário</span></a>
    <p class="sv-header-topic">Seguro de vida do crédito habitação<br /><strong>Simulação gratuita e sem compromisso</strong></p>
    <a class="sv-header-cta" href={destino} rel="sponsored noopener" data-seguro-link>Pedir simulação gratuita <span aria-hidden="true">↗</span></a>
  </div></header>
  <div id="conteudo">
    <section class="sv-hero"><div class="sv-container sv-hero-grid">
      <div class="sv-hero-copy">
        <p class="sv-eyebrow">Tem crédito habitação?</p>
        <h1>Está a pagar demasiado pelo <em>seguro de vida?</em></h1>
        <p class="sv-lead">Descubra se pode baixar este custo da casa. <strong>Peça uma simulação gratuita</strong> e ponha o preço que paga todos os meses à prova.</p>
        <a class="sv-button" href={destino} rel="sponsored noopener" data-seguro-link>Quero a minha simulação gratuita <span aria-hidden="true">↗</span></a>
        <p class="sv-benefit">Sem compromisso. Decide depois de conhecer a proposta.</p>
        <p class="sv-handoff">Pedido no site do parceiro, com contacto telefónico para analisar o seu caso.</p>
      </div>
      <div class="sv-hero-visual">
        <picture><source srcset="/imagens/artigos/vender-casa-com-credito-por-pagar.avif" type="image/avif" /><img src="/imagens/artigos/vender-casa-com-credito-por-pagar.webp" alt="Ilustração de uma casa portuguesa, documentos de crédito, um banco e moedas" width="1200" height="675" fetchpriority="high" /></picture>
        <div class="sv-visual-note"><div><strong>O preço atual já conhece.<br />Falta conhecer a alternativa.</strong><p>Ponha o seu seguro a competir pelo seu orçamento.</p></div></div>
      </div>
    </div></section>
    <div class="sv-partnership"><div class="sv-container">Publicidade · Conteúdo com ligações de afiliado para um parceiro de seguros.</div></div>
    <section class="sv-section sv-container sv-reasons" aria-labelledby="reasons-title">
      <div><p class="sv-eyebrow">Não pague por hábito</p><h2 id="reasons-title">O seguro veio com o crédito.<br />O preço ficou por comparar?</h2></div>
      <div class="sv-reasons-copy"><p>Na compra da casa havia muito para decidir. O seguro ficou tratado e os pagamentos continuaram. Mas <strong>continuar a pagar não lhe diz se tem um preço competitivo.</strong></p><p>Peça uma proposta nova. Se a alternativa compensar no custo global e na proteção, a diferença pode ficar no seu orçamento.</p></div>
    </section>
    <section class="sv-comparison" aria-labelledby="compare-title"><div class="sv-container">
      <p class="sv-eyebrow">O que ganha ao pedir</p><h2 id="compare-title">Um preço para pôr o seu à prova.</h2>
      <div class="sv-compare-grid">
        <article><span class="sv-number">01</span><h3>Descubra se pode pagar menos</h3><p>Deixe de adivinhar se o seguro está caro. Conheça uma alternativa para a sua situação.</p></article>
        <article><span class="sv-number">02</span><h3>Esclareça a proteção</h3><p>Use o contacto para saber o que a proposta inclui e como se compara com o seguro atual.</p></article>
        <article><span class="sv-number">03</span><h3>Decida sem compromisso</h3><p>Peça a simulação gratuitamente. Só avança para a mudança se a proposta lhe interessar.</p></article>
      </div>
      <p class="sv-compare-foot">Compare as coberturas, o custo ao longo do tempo e o efeito nas condições do crédito. É o resultado global que mostra se a mudança compensa.</p>
    </div></section>
    <section class="sv-container sv-action sv-action-middle" aria-label="Pedir uma nova proposta"><SeguroVidaCta canal="landing" titulo="Não deixe a dúvida passar para o próximo recibo." texto="Peça a sua simulação e descubra se existe uma alternativa mais barata para o seguro de vida da casa." botao="Quero descobrir se posso pagar menos" /></section>
    <section class="sv-section sv-container sv-process" id="como-funciona" aria-labelledby="process-title">
      <div><p class="sv-eyebrow">Comece pelo pedido</p><h2 id="process-title">Peça a simulação.<br />Faça as contas com uma proposta real.</h2><p>O primeiro passo é simples. A decisão de mudar vem depois.</p></div>
      <ol class="sv-steps">
        <li><span aria-hidden="true">1</span><div><h3>Aceda ao pedido</h3><p>O botão leva-o à página do parceiro.</p></div></li>
        <li><span aria-hidden="true">2</span><div><h3>Preencha o formulário</h3><p>Indique os dados pedidos e solicite contacto telefónico.</p></div></li>
        <li><span aria-hidden="true">3</span><div><h3>Ponha o seguro atual à prova</h3><p>Esclareça preço e coberturas e veja se a mudança compensa.</p></div></li>
      </ol>
    </section>
    <section class="sv-section sv-container sv-faq" aria-labelledby="faq-title">
      <div><p class="sv-eyebrow">Falta esclarecer alguma coisa?</p><h2 id="faq-title">Não precisa de mudar para descobrir outro preço.</h2></div>
      <div>{perguntas.map(({ pergunta, resposta }) => <details><summary>{pergunta}</summary><p>{resposta}</p></details>)}</div>
    </section>
    <section class="sv-container sv-action sv-action-final" aria-label="Pedir simulação gratuita"><SeguroVidaCta canal="landing" titulo="Antes de pagar mais um ano, descubra se pode pagar menos." texto="O seu seguro merece uma comparação. Peça a simulação gratuita e decida com os valores à frente." botao="Quero a minha simulação gratuita" /></section>
  </div>
  <footer class="sv-footer"><div class="sv-container">
    <a class="sv-brand" href="#conteudo"><Marca /><span>Guia do<br />Proprietário</span></a>
    <p class="sv-footer-note">O pedido de simulação e o tratamento dos dados são realizados no site do parceiro. A poupança depende da proposta e da situação de cada cliente.</p>
    <nav aria-label="Informação legal"><a href="/privacidade/">Privacidade</a><a href="/termos/">Termos</a><a href="/parceiros/">Parceiros</a><a href="#cookie-settings" data-cookie-settings>Definições de cookies</a></nav>
    <p class="sv-sources">Fontes: <a href="https://clientebancario.bportugal.pt/pt-pt/como-contratar-0">Banco de Portugal</a> e <a href="https://www.asf.com.pt/web/site-pc/w/seguro-de-vida-associado-ao-credito-a-habitacao">ASF</a>.</p>
    <small>© {new Date().getFullYear()} Guia do Proprietário.</small>
  </div></footer>
</Squeeze>
