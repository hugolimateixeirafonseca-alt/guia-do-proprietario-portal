---
import Squeeze from '../../../layouts/Squeeze.astro';
import Icon from '../../../components/CasaBanhoIcon.astro';
import '../../../styles/pdf-casa-banho.css';
const campaign='https://track.guiadoproprietario.pt/go/casa-banho-campanha?source=pdf-casa-de-banho-obrigado&utm_source=pdf-casa-de-banho&utm_medium=thank-you&utm_campaign=guia-banheira-duche-2026&utm_content=cta-obrigado';
---
<Squeeze titulo="O seu guia está a caminho | Veja a campanha de casa de banho" descricao="Enquanto recebe o PDF, veja a campanha de casa de banho e preencha o pedido de orçamento no site do parceiro." imagemOg="/imagens/landings/pdf-casa-de-banho/hero.webp" robots="noindex,follow">
<div class="pb pb-thanks">
<header class="pb-header pb-wrap"><a class="pb-brand" href="/"><Icon name="home"/>Guia do Proprietário</a></header>
<div class="pb-wrap"><p class="pb-confirm"><span>✓</span> Depois de concluir o pedido, o guia segue para o seu email. Verifique também as pastas de promoções e spam.</p></div>
<section class="pb-thanks-main pb-wrap"><div><span class="pb-pill">O próximo passo para a sua casa</span><h1>Troque a banheira.<br/>Ganhe conforto<br/>todos os dias.</h1><p class="pb-intro">Já tem o guia para preparar a mudança. Agora, <strong>veja a campanha e peça um orçamento para a sua casa de banho.</strong></p><div class="pb-thanks-action"><h2>O pedido faz-se no site do parceiro.</h2><p>Clique no botão, consulte as condições e preencha o formulário na página seguinte.</p><a class="pb-button" href={campaign} data-kit-campaign>Ver campanha e pedir orçamento <Icon name="arrow"/></a><p class="pb-thanks-note">Consulte as zonas abrangidas e as condições diretamente na página da campanha.</p></div><ol><li>Abra a campanha.</li><li>Preencha o pedido no site do parceiro.</li><li>Use o guia para comparar a proposta.</li></ol></div><figure><img src="/imagens/landings/pdf-casa-de-banho/hero.webp" alt="Antes e depois ilustrativo de uma banheira substituída por uma base de duche" width="965" height="700" fetchpriority="high"/></figure></section>
<section class="pb-thanks-reminder pb-wrap"><img src="/imagens/landings/pdf-casa-de-banho/capa.webp" width="849" height="1200" alt="Capa do guia enviado por email"/><div><h2>O guia ajuda-o a escolher.<br/>A proposta ajuda-o a decidir.</h2><p>Enquanto o PDF chega, descubra o próximo passo para a sua casa.</p><a href={campaign} data-kit-campaign>Ir para a campanha de casa de banho <Icon name="arrow"/></a></div></section>
<footer class="pb-footer pb-wrap"><a class="pb-brand" href="/"><Icon name="home"/>Guia do Proprietário</a><nav aria-label="Informação legal"><a href="/privacidade/">Privacidade</a><a href="/termos/">Termos</a><button type="button" data-cookie-settings>Cookies</button></nav><p>Conteúdo informativo. O Guia do Proprietário não executa obras.</p></footer>
</div>
</Squeeze>
<style>
.pb-thanks{background:#f5f9fb;min-height:100vh}.pb-confirm{padding:14px 18px;background:#e7f4ec;border:1px solid #d1e9da;border-radius:8px;color:#29603e;font-size:14px}.pb-confirm span{font-weight:bold;margin-right:7px}.pb-thanks-main{display:grid;grid-template-columns:1fr 1.03fr;gap:50px;align-items:center;padding-block:38px}.pb-thanks-main h1{font-size:53px;line-height:1.03;margin-bottom:20px}.pb-thanks-main figure{margin:0}.pb-thanks-main figure>img{width:100%;height:auto;border-radius:16px;box-shadow:0 16px 40px #1c42551a}.pb-thanks-main figcaption{font-size:11px;color:#607585;margin-top:6px;text-align:right}.pb-thanks-action{margin-top:24px}.pb-thanks-action h2{font-size:21px;margin-bottom:9px}.pb-thanks-action>p{font-size:15px}.pb-thanks-action .pb-button{margin:17px 0 10px;width:100%;font-size:19px;min-height:60px}.pb-thanks-action .pb-thanks-note{font-size:12px;color:#617589}.pb-thanks-main ol{padding-left:20px;margin:20px 0 0;font-size:14px}.pb-thanks-main li{padding:3px}.pb-thanks-reminder{display:flex;align-items:center;justify-content:center;gap:26px;background:white;border:1px solid #e0eaef;border-radius:12px;padding:24px}.pb-thanks-reminder img{width:83px;height:auto;transform:rotate(-4deg);box-shadow:3px 5px 8px #0002}.pb-thanks-reminder h2{font-size:25px}.pb-thanks-reminder p{font-size:14px;margin-top:10px}.pb-thanks-reminder a{display:inline-flex;gap:10px;align-items:center;color:#27874b;font-weight:bold;margin-top:12px}.pb-thanks-reminder svg{width:20px;height:20px}@media(max-width:720px){.pb-thanks-main{grid-template-columns:1fr;gap:26px;padding-block:28px}.pb-thanks-main h1{font-size:43px}.pb-confirm{font-size:12px;padding:12px}.pb-thanks-action .pb-button{font-size:16px;gap:8px;padding-inline:12px}.pb-thanks-reminder{padding:21px 15px;gap:18px}.pb-thanks-reminder h2{font-size:20px}.pb-thanks-reminder img{width:65px}.pb-thanks-reminder p,.pb-thanks-reminder a{font-size:12px}}@media(max-width:360px){.pb-thanks-main h1{font-size:38px}.pb-thanks-action .pb-button{font-size:14px}}
</style>
<script>
import { prepararCampanhaPdfBanho } from '../../../lib/pdf-casa-banho-campaign.mjs';
prepararCampanhaPdfBanho(document, window);
</script>
