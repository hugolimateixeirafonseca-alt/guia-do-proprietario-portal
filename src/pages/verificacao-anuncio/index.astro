---
import BaseLayout from "../../layouts/BaseLayout.astro";

const checks = [
  { id: 1, title: "Localização", state: "confirmado", label: "Confirmado" },
  { id: 3, title: "Tipologia e área", state: "confirmado", label: "Confirmado" },
  { id: 4, title: "Coerência visual", state: "confirmado", label: "Observado" },
  { id: 8, title: "Contrato escrito", state: "por-confirmar", label: "Por confirmar" }
];

const reportChecks = [
  { id: 1, title: "Morada ou zona identificável", state: "confirmado", label: "Confirmado", observation: "Lisboa e Arroios aparecem no texto enviado.", action: null },
  { id: 2, title: "Preço face à referência da zona", state: "nao-verificavel", label: "Não verificável", observation: "O preço está visível, mas falta uma área utilizável para comparar por metro quadrado.", action: null },
  { id: 3, title: "Tipologia e área coerentes", state: "confirmado", label: "Confirmado", observation: "A tipologia T1 aparece de forma consistente nas capturas de ecrã analisadas.", action: null },
  { id: 4, title: "Coerência visual e detalhes a confirmar", state: "por-confirmar", label: "Confirmar em direto", observation: "Os acabamentos parecem coerentes, mas a zona junto à janela só aparece parcialmente.", action: "Durante a videochamada, peça para mostrarem a parede junto à janela e a divisão sem cortes." },
  { id: 5, title: "Despesas incluídas", state: "por-confirmar", label: "Por confirmar", observation: "O anúncio não especifica quais as despesas incluídas no valor mensal.", action: "Confirme por escrito quais as despesas incluídas e quais serão pagas à parte." },
  { id: 6, title: "Condições de pagamento", state: "por-confirmar", label: "Merece atenção", observation: "O anúncio pede uma caução para reservar antes da visita.", action: "Não transfira. Visite o imóvel, confirme quem arrenda e receba a minuta do contrato primeiro." },
  { id: 7, title: "Visita presencial", state: "confirmado", label: "Confirmado", observation: "Existe indicação de visitas presenciais por marcação.", action: null },
  { id: 8, title: "Contrato escrito", state: "por-confirmar", label: "Por confirmar", observation: "Não foi encontrada uma menção explícita a contrato escrito.", action: "Peça confirmação por escrito e solicite a minuta antes de transferir dinheiro." },
  { id: 9, title: "Recibos de renda", state: "por-confirmar", label: "Por confirmar", observation: "Não foi encontrada uma menção explícita à emissão de recibos.", action: "Confirme por escrito que serão emitidos os recibos aplicáveis." },
  { id: 10, title: "Titular da conta", state: "por-confirmar", label: "Por confirmar", observation: "O nome do titular da conta não aparece nas capturas de ecrã enviadas.", action: "Peça o nome completo do titular da conta e confirme a relação com o arrendamento." },
  { id: 11, title: "Propriedade ou autorização documental", state: "nao-verificavel", label: "Confirmar com documento", observation: "As capturas não permitem confirmar quem está autorizado a arrendar o imóvel.", action: "Peça documentação que confirme quem é o proprietário ou está autorizado a arrendar o imóvel." },
  { id: 12, title: "Comunicação às Finanças e recibos", state: "confirmado", label: "Confirmado", observation: "O anúncio menciona comunicação do contrato e emissão de recibos.", action: null }
];
const checkoutEnabled = import.meta.env.PUBLIC_VERIFICACAO_CHECKOUT_ENABLED === "true";
---

<BaseLayout
  titulo="Verificação de Anúncio"
  descricao="Identificamos sinais observáveis, interpretamos as fotografias e mostramos o que deve fazer antes de transferir dinheiro."
>
  <div class="preview-ribbon"><strong>Oferta de lançamento: 7,99 €</strong><span>{checkoutEnabled ? "Pagamento seguro processado pela Stripe." : "Pré-visualização local. Pagamento e análise ainda não estão ativos."}</span></div>
  <section class="hero">
    <div class="hero-glow hero-glow-one" aria-hidden="true"></div>
    <div class="hero-glow hero-glow-two" aria-hidden="true"></div>
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Verificação de anúncio para arrendamento</p>
        <div class="hero-ai"><span>IA</span><div><strong>Sistema inteligente com IA</strong><small>Análise automática. Normalmente pronta em poucos minutos.</small></div></div>
        <h1>Não transfira a caução <span>às cegas.</span></h1>
        <p class="lead">Envie as capturas de ecrã do anúncio. O sistema inteligente lê o texto, interpreta o que é visível nas fotografias e cruza as condições antes de qualquer pagamento.</p>
        <div class="hero-offer">
          <div class="hero-price">
            <span class="old-price">11,99 €</span>
            <strong>7,99 €</strong>
            <small>Preço de lançamento</small>
          </div>
          <a class="primary-action" href="/verificacao/enviar/">Verificar capturas grátis <span aria-hidden="true">→</span></a>
        </div>
        <p class="pay-later">Primeiro recebe uma pré-verificação e um teaser. Só depois decide se quer pagar 7,99 € pelo relatório completo.</p>
        <ul class="trust-list" aria-label="O que está incluído">
          <li>Pré-verificação gratuita com IA</li>
          <li>Leitura inteligente das fotografias</li>
          <li>Comparação do preço na cidade</li>
          <li>Relatório normalmente pronto em poucos minutos</li>
        </ul>
      </div>

      <div class="product-visual">
        <div class="floating-alert"><span>!</span><div><small>Detalhe a confirmar</small><strong>Parede junto à janela</strong></div></div>
        <div class="report-preview" aria-label="Exemplo resumido do relatório">
        <div class="report-top">
          <div>
            <span class="report-kicker">O seu relatório</span>
            <strong>A decisão antes de pagar</strong>
          </div>
          <span class="report-score report-verdict-pill">Não pague ainda</span>
        </div>
        <div class="report-verdict-preview"><small>Sinal principal</small><strong>A caução é pedida antes da visita.</strong><p>Não transfira. Peça uma visita, confirme quem arrenda e receba a minuta do contrato primeiro.</p></div>
        <div class="check-list">
          {checks.map((check) => (
            <div class="check-row">
              <span class={`check-icon ${check.state}`}>{check.state === "confirmado" ? "✓" : "?"}</span>
              <span class="check-copy"><small>Verificação {check.id}</small><strong>{check.title}</strong></span>
              <span class={`state-pill ${check.state}`}>{check.label}</span>
            </div>
          ))}
        </div>
          <p class="report-note">Primeiro recebe a decisão. As 12 verificações ficam disponíveis como evidência detalhada.</p>
        </div>
        <div class="floating-proof"><span>✓</span><div><small>Perguntas prontas</small><strong>Copiar e enviar ao anunciante</strong></div></div>
      </div>
    </div>
  </section>

  <section class="intro-strip" id="experimentar">
    <div class="shell intro-grid">
      <div><span>IA</span><strong>fotografias interpretadas</strong><p>Destacamos coerência, detalhes visíveis e o que deve pedir para ver em direto.</p></div>
      <div><span>10</span><strong>cidades com referência</strong><p>Comparamos o preço quando existem dados suficientes.</p></div>
      <div><span>12</span><strong>pontos cruzados</strong><p>Detetamos omissões e preparamos perguntas concretas.</p></div>
    </div>
  </section>

  <section class="risk-section">
    <div class="shell">
      <div class="section-heading risk-heading">
        <div><p class="eyebrow">O que o anúncio não lhe diz</p><h2>Três detalhes podem mudar completamente a decisão.</h2></div>
        <p>Um anúncio bonito não responde às perguntas mais importantes. A verificação transforma capturas de ecrã dispersas num relatório claro antes de enviar dinheiro.</p>
      </div>
      <div class="risk-grid">
        <article class="risk-card risk-visual">
          <div class="risk-card-copy"><span class="risk-number">01</span><p class="risk-label">Leitura visual com IA</p><h3>O que revelam realmente estas fotografias?</h3><p>Analisamos coerência, elementos visíveis, possíveis distorções e detalhes que deve confirmar numa visita ou videochamada.</p></div>
          <div class="match-visual" aria-hidden="true">
            <div class="mock-photo"><span>Captura 1</span><div class="mock-room"><i></i><b></b></div></div>
            <div class="match-link">↔</div>
            <div class="mock-photo flagged"><span>Captura 3</span><div class="mock-room"><i></i><b></b></div><strong>Acabamentos coerentes</strong></div>
          </div>
        </article>
        <article class="risk-card price-risk">
          <span class="risk-number">02</span><p class="risk-label">Referência de preço</p><h3>O valor faz sentido para a zona?</h3>
          <div class="price-meter" aria-hidden="true"><span></span><i></i></div>
          <div class="meter-labels"><span>Abaixo</span><strong>Referência</strong><span>Acima</span></div>
          <p>Quando existem dados suficientes, o preço é comparado com a referência local.</p>
        </article>
        <article class="risk-card transfer-risk">
          <span class="risk-number">03</span><p class="risk-label">Antes da transferência</p><h3>Sabe exatamente quem vai receber?</h3>
          <div class="question-stack" aria-hidden="true"><span>Quem é o titular da conta?</span><span>Existe contrato escrito?</span><span>São emitidos recibos?</span></div>
          <p>Recebe perguntas específicas para obter respostas por escrito.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="demo-section">
    <div class="shell demo-grid">
      <div class="demo-copy">
        <p class="eyebrow">Veja a análise em ação</p>
        <h2>Envie as capturas de ecrã. Nós fazemos o trabalho difícil.</h2>
        <p>Inclua o texto, o preço, as condições, a conversa relevante e as fotografias. A demonstração organiza tudo e mostra como será o relatório.</p>
        <div class="upload-tips">
          <div><span>IA</span><p><strong>Leitura visual</strong> das divisões e detalhes visíveis.</p></div>
          <div><span>10</span><p><strong>Referências locais</strong> para comparar o preço.</p></div>
          <div><span>12</span><p><strong>Pontos cruzados</strong> num relatório acionável.</p></div>
        </div>
      </div>

      <form class="upload-card" data-demo-form>
        <div class="upload-card-head">
          <div><small>Demonstração interativa</small><strong>Comece pelas capturas de ecrã (screenshot) do anúncio</strong></div>
          <span data-file-count>0 adicionados</span>
        </div>
        <label class="drop-zone" for="ad-files">
          <span class="upload-mark" aria-hidden="true">↑</span>
          <strong>Adicione as capturas de ecrã (screenshot) do anúncio</strong>
          <span>Texto, preço, condições e fotografias. Pode enviar até 8 ficheiros.</span>
          <input id="ad-files" type="file" accept="image/png,image/jpeg,image/webp" multiple data-file-input />
        </label>
        <div class="selected-files" data-selected-files aria-live="polite">
          <p>Ainda não escolheu ficheiros.</p>
        </div>
        <label class="city-field" for="ad-city"><span>Cidade indicada no anúncio</span>
          <select id="ad-city" data-city-select>
            <option value="">Escolha a cidade</option>
            <option>Aveiro</option><option>Braga</option><option>Coimbra</option><option>Covilhã</option><option>Évora</option><option>Faro</option><option>Guimarães</option><option>Leiria</option><option>Lisboa</option><option>Porto</option><option>Outra</option>
          </select>
        </label>
        <p class="upload-status" data-upload-status>Comece pelas capturas de ecrã que mostram o texto, o preço e as fotografias.</p>
        <div class="demo-actions">
          <button type="submit" disabled data-run-demo>Ver a análise em ação</button>
          <button type="button" class="text-button" data-show-example>Ver relatório de exemplo</button>
        </div>
      </form>
    </div>
  </section>

  <section class="processing-section" data-processing hidden>
    <div class="shell processing-card">
      <div class="processing-heading"><span class="spinner" aria-hidden="true"></span><div><p class="eyebrow">Análise em curso</p><h2 data-processing-title>A organizar a informação do anúncio</h2></div><strong data-processing-percent>18%</strong></div>
      <div class="processing-track"><span data-processing-bar></span></div>
      <div class="processing-steps">
        <span class="active">Leitura das capturas</span><span>Interpretação das fotografias</span><span>Cruzamento das condições</span><span>Relatório</span>
      </div>
    </div>
  </section>

  <section class="results-section" id="relatorio-exemplo" data-results hidden>
    <div class="shell">
      <div class="results-heading">
        <div><p class="eyebrow">Relatório de demonstração</p><h2>Primeiro a decisão. Depois, a prova.</h2></div>
        <div class="result-summary decision-demo"><strong>!</strong><span>Não pague ainda</span></div>
      </div>
      <div class="demo-decision"><span>Sinal principal</span><h3>O anúncio pede caução antes da visita.</h3><p>Não transfira ainda. Marque a visita, confirme quem arrenda e receba a minuta do contrato primeiro.</p></div>
      <div class="summary-band">
        <div class="attention"><strong>1 sinal concreto</strong><span>Baseado nas condições de pagamento.</span></div>
        <div class="good"><strong>4 leituras visuais</strong><span>Coerência, elementos visíveis e provas a pedir.</span></div>
        <div class="neutral"><strong>5 perguntas prontas</strong><span>Para copiar e enviar ao anunciante.</span></div>
      </div>

      <div class="report-layout">
        <div class="full-checks">
          {reportChecks.map((check) => (
            <article class={`result-card ${check.state}`}>
              <header>
                <span class="result-number">{String(check.id).padStart(2, "0")}</span>
                <div><h3>{check.title}</h3><span class={`state-pill ${check.state}`}>{check.label}</span></div>
              </header>
              <p>{check.observation}</p>
              {check.action && <div class="next-step"><strong>O que fazer agora</strong><span>{check.action}</span></div>}
            </article>
          ))}
        </div>

        <aside class="evidence-column">
          <section class="evidence-card visual-evidence">
            <p class="eyebrow">O que as fotografias revelam</p>
            <h3>3 elementos coerentes e 1 detalhe a confirmar</h3>
            <div class="photo-pair"><div><span>Captura 1</span><div class="room-shape"><i></i><b></b></div></div><div><span>Captura 3</span><div class="room-shape alternate"><i></i><b></b></div></div></div>
            <p>O pavimento e os acabamentos são coerentes. A zona junto à janela aparece apenas parcialmente e deve ser mostrada em direto.</p>
          </section>
          <section class="evidence-card price-evidence">
            <p class="eyebrow">Preço</p>
            <h3>1.350 € por mês</h3>
            <div class="price-line"><span>Anúncio</span><strong>Área em falta</strong></div>
            <div class="price-line"><span>Referência de Lisboa</span><strong>23,5 €/m²</strong></div>
            <p>Sem uma área explícita, não é feita a comparação por metro quadrado.</p>
          </section>
          <section class="evidence-card questions-card">
            <p class="eyebrow">Perguntas prontas</p>
            <h3>Copie antes de responder ao anúncio.</h3>
            <ol>
              <li>Pode confirmar quais as despesas incluídas?</li>
              <li>Pode enviar a minuta do contrato?</li>
              <li>Em nome de quem será feita a transferência?</li>
            </ol>
            <button type="button" data-copy-questions>Copiar as 3 perguntas</button>
            <span class="copy-status" data-copy-status aria-live="polite"></span>
          </section>
        </aside>
      </div>
    </div>
  </section>

  <section class="pricing-section" id="comprar">
    <div class="shell pricing-card">
      <div class="pricing-copy"><p class="eyebrow">Primeiro veja se as suas capturas servem</p><h2>Envie primeiro. Pague só depois do teaser.</h2><p>O sistema inteligente com IA confirma gratuitamente se o material é suficiente e mostra uma primeira leitura do seu anúncio. Só depois decide se quer desbloquear a leitura visual, as 12 verificações e o relatório completo.</p><ul><li>Pré-verificação sem custo</li><li>Uma única compra</li><li>Sem subscrição</li><li>Normalmente pronto em poucos minutos</li></ul></div>
      <div class="price-box"><span class="offer-badge">Oferta de lançamento</span><span class="previous-price">Antes 11,99 €</span><strong>7,99 €</strong><span class="per-analysis">apenas depois de aprovar as capturas</span><a class="intake-action" href="/verificacao/enviar/">Enviar capturas antes de pagar</a><small data-checkout-status>{checkoutEnabled ? "Pré-verificação gratuita. Pagamento seguro através da Stripe." : "Percurso em validação final. A compra pública continua desligada."}</small></div>
    </div>
  </section>

  <section class="faq-section">
    <div class="shell faq-wrap">
      <div><p class="eyebrow">Sem letras pequenas</p><h2>Saiba exatamente o que recebe.</h2></div>
      <div class="faq-list">
        <details open><summary>A análise confirma quem está a arrendar o imóvel?</summary><p>Não. Organiza a informação disponível e indica os documentos ou confirmações que ainda deve pedir.</p></details>
        <details><summary>O que consegue a IA observar nas fotografias?</summary><p>Destaca coerência entre divisões, características visíveis, enquadramentos e detalhes que deve confirmar numa visita ou videochamada. Não substitui uma inspeção técnica.</p></details>
        <details><summary>Posso enviar uma ligação em vez de capturas de ecrã?</summary><p>O envio é feito através de capturas de ecrã que mostram o texto, o preço, as condições e as fotografias do anúncio.</p></details>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-demo-form]");
  const fileInput = document.querySelector<HTMLInputElement>("[data-file-input]");
  const citySelect = document.querySelector<HTMLSelectElement>("[data-city-select]");
  const fileCount = document.querySelector<HTMLElement>("[data-file-count]");
  const selectedFiles = document.querySelector<HTMLElement>("[data-selected-files]");
  const uploadStatus = document.querySelector<HTMLElement>("[data-upload-status]");
  const runButton = document.querySelector<HTMLButtonElement>("[data-run-demo]");
  const showExample = document.querySelector<HTMLButtonElement>("[data-show-example]");
  const processing = document.querySelector<HTMLElement>("[data-processing]");
  const results = document.querySelector<HTMLElement>("[data-results]");

  const refreshFiles = () => {
    if (!fileInput || !selectedFiles || !fileCount || !runButton || !uploadStatus) return;
    const files = Array.from(fileInput.files || []).slice(0, 8);
    fileCount.textContent = `${files.length} ${files.length === 1 ? "adicionado" : "adicionados"}`;
    selectedFiles.innerHTML = files.length
      ? files.map((file, index) => `<div><span>${index + 1}</span><strong>${file.name.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")}</strong><small>${Math.max(1, Math.round(file.size / 1024))} KB</small></div>`).join("")
      : "<p>Ainda não escolheu ficheiros.</p>";
    const ready = files.length >= 1 && files.length <= 8 && Boolean(citySelect?.value);
    runButton.disabled = !ready;
    uploadStatus.textContent = files.length === 0
      ? "Comece pelas capturas de ecrã que mostram o texto, o preço e as fotografias."
      : !citySelect?.value ? "Escolha a cidade indicada no anúncio." : "Tudo pronto para a demonstração.";
  };

  fileInput?.addEventListener("change", refreshFiles);
  citySelect?.addEventListener("change", refreshFiles);

  const revealResults = () => {
    if (!results) return;
    results.hidden = false;
    results.scrollIntoView({ behavior: "smooth", block: "start" });
  };

  showExample?.addEventListener("click", revealResults);

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!processing || !results || !runButton) return;
    processing.hidden = false;
    results.hidden = true;
    processing.scrollIntoView({ behavior: "smooth", block: "center" });
    runButton.disabled = true;

    const stages = [
      { percent: 18, title: "A organizar a informação do anúncio" },
      { percent: 42, title: "A separar as fotografias do imóvel" },
      { percent: 71, title: "A interpretar os detalhes visíveis" },
      { percent: 93, title: "A construir as 12 verificações" },
      { percent: 100, title: "Relatório de demonstração concluído" }
    ];
    let index = 0;
    const tick = () => {
      const stage = stages[index];
      const bar = processing.querySelector<HTMLElement>("[data-processing-bar]");
      const percent = processing.querySelector<HTMLElement>("[data-processing-percent]");
      const title = processing.querySelector<HTMLElement>("[data-processing-title]");
      if (bar) bar.style.width = `${stage.percent}%`;
      if (percent) percent.textContent = `${stage.percent}%`;
      if (title) title.textContent = stage.title;
      index += 1;
      if (index < stages.length) window.setTimeout(tick, 520);
      else window.setTimeout(() => { processing.hidden = true; revealResults(); refreshFiles(); }, 550);
    };
    tick();
  });

  document.querySelector<HTMLButtonElement>("[data-copy-questions]")?.addEventListener("click", async () => {
    const questions = "1. Pode confirmar quais as despesas incluídas?\n2. Pode enviar a minuta do contrato?\n3. Em nome de quem será feita a transferência?";
    const status = document.querySelector<HTMLElement>("[data-copy-status]");
    try {
      await navigator.clipboard.writeText(questions);
      if (status) status.textContent = "Perguntas copiadas.";
    } catch {
      if (status) status.textContent = "Selecione e copie as perguntas acima.";
    }
  });
</script>

