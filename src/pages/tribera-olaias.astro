---
import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.astro";

const bookingUrl = "https://triberaliving.com/pt-pt/lisbon/lisbon-olaias-student-accommodation/?utm_source=guiadoproprietario&utm_medium=referral&utm_campaign=tribera_olaias";
const triberaPage = "https://triberaliving.com/pt-pt/lisbon/lisbon-olaias-student-accommodation/?utm_source=guiadoproprietario&utm_medium=referral&utm_campaign=tribera_olaias";
const pageTitle = "Residência de estudantes nas Olaias, Lisboa | Guia do Proprietário";
const pageDescription = "Conheça a Tribera Lisbon Olaias: quartos e estúdios mobilados, despesas incluídas, piscina no rooftop, ginásio 24/7 e metro à porta.";
const canonical = "https://guiadoproprietario.pt/tribera-olaias/";
const promoCode = "GUIAPRO_D2027";

const benefits = [
  { icon: "wallet", title: "Contas incluídas", text: "Eletricidade, água, aquecimento e Wi-Fi incluídos no valor mensal." },
  { icon: "train", title: "Transportes à porta", text: "Metro e autocarros mesmo à porta para chegares facilmente a qualquer zona de Lisboa." },
  { icon: "pool", title: "Piscina no rooftop", text: "Um espaço no topo do edifício para desligar dos estudos e aproveitar Lisboa." },
  { icon: "gym", title: "Ginásio 24/7", text: "Treina quando quiseres, sem sair da residência e sem custo extra." },
  { icon: "shield", title: "Segurança 24/7", text: "Equipa no local e sistemas de segurança para uma experiência mais tranquila." },
  { icon: "study", title: "Estudar e conviver", text: "Salas de estudo, cozinha social, lounges, sala de jogos e cinema." }
];

const gallery = [
  { src: "https://triberaliving.com/wp-content/uploads/2025/10/Milestone-Olaias-49.jpg", alt: "Piscina no rooftop da residência Tribera Lisbon Olaias", className: "gallery-wide" },
  { src: "https://triberaliving.com/wp-content/uploads/2025/10/Milestone-Olaias-11.jpg", alt: "Quarto mobilado na residência Tribera Lisbon Olaias", className: "" },
  { src: "https://triberaliving.com/wp-content/uploads/2025/10/Milestone-Olaias-30.jpg", alt: "Zona comum da residência Tribera Lisbon Olaias", className: "" },
  { src: "https://triberaliving.com/wp-content/uploads/2025/10/Milestone-Olaias-72.jpg", alt: "Ginásio da residência Tribera Lisbon Olaias", className: "" },
  { src: "https://triberaliving.com/wp-content/uploads/2025/10/Milestone-Olaias-70.jpg", alt: "Sala de cinema da residência Tribera Lisbon Olaias", className: "" },
  { src: "https://triberaliving.com/wp-content/uploads/2025/10/Milestone-Olaias-25.jpg", alt: "Cozinha social da residência Tribera Lisbon Olaias", className: "gallery-wide" }
];
---
<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://triberaliving.com/wp-content/uploads/2025/10/Milestone-Olaias-49.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="index,follow" />
    <title>{pageTitle}</title>
  </head>
  <body class="tribera-landing">
    <div class="promo-strip"><strong>VANTAGEM GUIA:</strong> em vez de pagar inicialmente 230,00 € pela reserva, paga apenas 80,00 € com o promocode <span>{promoCode}</span>.</div>
    <a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

    <header class="landing-header">
      <a class="landing-brand" href="/" aria-label="Guia do Proprietário - página inicial">
        <span class="brand-mark" aria-hidden="true">G</span>
        <span>Guia do Proprietário</span>
      </a>
      <div class="header-partner"><span>ALOJAMENTO PARCEIRO</span><strong>Tribera · Olaias</strong></div>
      <a class="header-cta" href={bookingUrl} data-booking>Reservar com {promoCode}</a>
    </header>

    <main id="conteudo">
      <section class="hero-section">
        <div class="hero-photo" role="img" aria-label="Quarto mobilado na residência Tribera Lisbon Olaias"></div>
        <div class="hero-overlay"></div>
        <div class="hero-container">
          <div class="hero-copy">
            <div class="location-pill"><span aria-hidden="true">●</span> OLAIAS · LISBOA</div>
            <h1>Um quarto em Lisboa.<br /><em>Sem tratar de tudo o resto.</em></h1>
            <p class="hero-lead">Para quem vai estudar em Lisboa - e para os pais que querem deixar esta parte resolvida. Quartos e estúdios mobilados, contas incluídas, metro à porta e uma residência com tudo para viver, estudar e conhecer pessoas.</p>

            <div class="hero-price-row">
              <div class="price-block">
                <span>A partir de</span>
                <strong>819 €<small>/mês</small></strong>
                <span>preço base anunciado · despesas incluídas</span>
              </div>
              <div class="partner-benefit">
                <span>VANTAGEM GUIA</span>
                <strong>80 € na reserva</strong>
                <small>em vez de 230,00 €</small>
                <code>{promoCode}</code>
              </div>
            </div>

            <div class="hero-actions">
              <a class="cta-primary" href={bookingUrl} data-booking>
                Ver quartos disponíveis
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
              </a>
              <a class="cta-link" href="#quartos">Comparar opções</a>
            </div>
            <p class="microcopy"><span aria-hidden="true">✓</span> Usa o promocode <strong>{promoCode}</strong> no momento da reserva para pagar apenas 80,00 € em vez dos 230,00 € iniciais.</p>
          </div>
        </div>
      </section>

      <section class="proof-strip" aria-label="Principais vantagens">
        <div><strong>Contas incluídas</strong><span>sem surpresas no fim do mês</span></div>
        <div><strong>Metro à porta</strong><span>Lisboa fica muito mais perto</span></div>
        <div><strong>Ginásio 24/7</strong><span>incluído na residência</span></div>
        <div><strong>Piscina no rooftop</strong><span>um extra difícil de ignorar</span></div>
      </section>

      <section class="section intro-section">
        <div class="landing-container intro-grid">
          <div class="section-copy">
            <span class="eyebrow">MILESTONE BY TRIBERA · LISBON OLAIAS</span>
            <h2>Não é apenas um sítio para dormir.</h2>
            <p class="large-copy">É uma residência preparada para tornar a vida de estudante mais simples: chegas, instalas-te e tens o essencial tratado.</p>
            <p>O valor mensal inclui eletricidade, água, aquecimento e Wi-Fi. E quando fechas a porta do quarto, continuas a ter piscina, ginásio, áreas de estudo, cozinha social, sala de cinema e espaços comuns no mesmo edifício.</p>
          </div>
          <figure class="feature-photo">
            <img src="https://triberaliving.com/wp-content/uploads/2025/10/Milestone-Olaias-49.jpg" alt="Piscina no rooftop da Tribera Lisbon Olaias" width="1500" height="1000" loading="lazy" decoding="async" />
            <figcaption><strong>Rooftop pool</strong><span>Lisbon Olaias</span></figcaption>
          </figure>
        </div>
      </section>

      <section class="section rooms-section" id="quartos">
        <div class="landing-container">
          <div class="section-heading landing-heading">
            <span class="eyebrow">ESCOLHE O TEU ESPAÇO</span>
            <h2>Duas formas de viver nas Olaias.</h2>
            <p>Mais independente ou mais social. Em ambas, as despesas essenciais estão incluídas.</p>
          </div>

          <div class="room-grid">
            <article class="room-card room-card-featured">
              <div class="room-image">
                <img src="https://triberaliving.com/wp-content/uploads/2025/10/Milestone-Olaias-11.jpg" alt="Quarto de estudante mobilado na Tribera Lisbon Olaias" width="1400" height="930" loading="lazy" decoding="async" />
                <span class="room-badge">PREÇO MAIS BAIXO</span>
              </div>
              <div class="room-content">
                <div class="room-title-row">
                  <div><span>DUO APARTMENT</span><h3>O teu quarto. Uma casa a dois.</h3></div>
                  <div class="room-price"><span>desde</span><strong>819 €</strong><small>/mês</small></div>
                </div>
                <p>Tens o teu próprio quarto mobilado e partilhas cozinha, casa de banho e zona de refeições com outra pessoa.</p>
                <ul>
                  <li>Quarto privado de 7-12 m²</li>
                  <li>Cama de 100 cm, secretária e arrumação</li>
                  <li>Cozinha e casa de banho partilhadas</li>
                  <li>Contas e Wi-Fi incluídos</li>
                </ul>
                <a class="room-cta" href={bookingUrl} data-booking>Ver disponibilidade do Duo <span>→</span></a>
              </div>
            </article>

            <article class="room-card">
              <div class="room-image">
                <img src="https://triberaliving.com/wp-content/uploads/2025/10/Milestone-Olaias-62.jpg" alt="Exterior da residência Tribera Lisbon Olaias" width="1400" height="930" loading="lazy" decoding="async" />
                <span class="room-badge neutral">MAIS PRIVACIDADE</span>
              </div>
              <div class="room-content">
                <div class="room-title-row">
                  <div><span>THE STUDIO</span><h3>O teu espaço, só para ti.</h3></div>
                  <div class="room-price"><span>desde</span><strong>869 €</strong><small>/mês</small></div>
                </div>
                <p>Um estúdio mobilado com casa de banho privativa e minicozinha, para quem quer máxima autonomia.</p>
                <ul>
                  <li>Estúdio de 11-13 m²</li>
                  <li>Casa de banho privativa</li>
                  <li>Minicozinha com micro-ondas e mini-frigorífico</li>
                  <li>Contas e Wi-Fi incluídos</li>
                </ul>
                <a class="room-cta" href={bookingUrl} data-booking>Ver disponibilidade do Studio <span>→</span></a>
              </div>
            </article>
          </div>
          <p class="price-note">Os valores de 819 € e 869 € correspondem aos preços base anunciados pela Tribera. A disponibilidade, duração do contrato e preço aplicável à data da reserva são confirmados no sistema de reservas da Tribera.</p>
        </div>
      </section>

      <section class="section benefits-section">
        <div class="landing-container">
          <div class="section-heading landing-heading compact-heading">
            <span class="eyebrow">TUDO NO MESMO EDIFÍCIO</span>
            <h2>Menos logística. Mais vida.</h2>
          </div>
          <div class="benefit-grid">
            {benefits.map((benefit) => (
              <article class="benefit-card">
                <div class={`benefit-icon icon-${benefit.icon}`} aria-hidden="true">
                  {benefit.icon === "wallet" && <svg viewBox="0 0 24 24"><path d="M4 7h14a2 2 0 0 1 2 2v9H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h13v3"/><path d="M15 11h5v4h-5a2 2 0 0 1 0-4Z"/></svg>}
                  {benefit.icon === "train" && <svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="15" rx="3"/><path d="M8 21l2-3m6 3-2-3M8 8h8M8 13h.01M16 13h.01"/></svg>}
                  {benefit.icon === "pool" && <svg viewBox="0 0 24 24"><path d="M3 17c2 0 2-1.5 4-1.5S9 17 11 17s2-1.5 4-1.5S17 17 19 17s2-1.5 2-1.5M3 21c2 0 2-1.5 4-1.5S9 21 11 21s2-1.5 4-1.5S17 21 19 21s2-1.5 2-1.5M7 14V6a3 3 0 0 1 6 0M7 10h6"/></svg>}
                  {benefit.icon === "gym" && <svg viewBox="0 0 24 24"><path d="M7 9v6m10-6v6M4 10v4m16-4v4M7 12h10M2 11v2m20-2v2"/></svg>}
                  {benefit.icon === "shield" && <svg viewBox="0 0 24 24"><path d="M12 3 20 6v6c0 5-3.4 8-8 9-4.6-1-8-4-8-9V6l8-3Z"/><path d="m9 12 2 2 4-5"/></svg>}
                  {benefit.icon === "study" && <svg viewBox="0 0 24 24"><path d="M4 5h6a3 3 0 0 1 3 3v11a3 3 0 0 0-3-3H4V5Zm16 0h-4a3 3 0 0 0-3 3v11a3 3 0 0 1 3-3h4V5Z"/></svg>}
                </div>
                <h3>{benefit.title}</h3>
                <p>{benefit.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="gallery-section" aria-labelledby="galeria-title">
        <div class="landing-container">
          <div class="gallery-heading">
            <div><span class="eyebrow">VÊ ANTES DE DECIDIR</span><h2 id="galeria-title">Conheça alguns espaços da residência.</h2></div>
            <p>Fotografias da Tribera Lisbon Olaias.</p>
          </div>
          <div class="gallery-grid">
            {gallery.map((image) => (
              <figure class={image.className}>
                <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section class="section location-section">
        <div class="landing-container location-grid">
          <div class="location-card">
            <span class="location-kicker">OLAIAS · LISBOA</span>
            <h2>A cidade começa à porta.</h2>
            <p>Metro e autocarros mesmo à porta, supermercado e cafés a poucos minutos e ligação simples ao centro, às universidades e ao aeroporto.</p>
            <div class="time-grid">
              <div><strong>2 min</strong><span>supermercado</span></div>
              <div><strong>15 min</strong><span>campus de bicicleta</span></div>
              <div><strong>20 min</strong><span>centro de metro</span></div>
              <div><strong>20 min</strong><span>aeroporto</span></div>
            </div>
            <p class="address">R. Prof.ª Margarida Vieira Mendes · Olaias · Lisboa</p>
          </div>
          <div class="location-photo">
            <img src="https://triberaliving.com/wp-content/uploads/2025/10/Milestone-Olaias-62.jpg" alt="Edifício da residência Tribera Lisbon Olaias" width="1600" height="1067" loading="lazy" decoding="async" />
            <div class="photo-stamp"><span>METRO</span><strong>à porta</strong></div>
          </div>
        </div>
      </section>

      <section class="section parents-section">
        <div class="landing-container parents-grid">
          <div class="parents-photo">
            <img src="https://triberaliving.com/wp-content/uploads/2025/10/Milestone-Olaias-30.jpg" alt="Espaços comuns da residência Tribera Lisbon Olaias" width="1400" height="930" loading="lazy" decoding="async" />
          </div>
          <div class="parents-copy">
            <span class="eyebrow">PARA QUEM VAI. E PARA QUEM FICA.</span>
            <h2>Uma escolha mais simples também para os pais.</h2>
            <p>Quando um filho vai estudar para outra cidade, há demasiadas coisas para resolver ao mesmo tempo. Aqui, habitação, contas, internet, segurança, espaços de estudo e várias comodidades ficam concentrados numa única solução.</p>
            <ul class="check-list">
              <li><span>✓</span> Valor mensal previsível com despesas essenciais incluídas</li>
              <li><span>✓</span> Contrato e pagamentos geridos pela Tribera</li>
              <li><span>✓</span> Segurança e equipa no local</li>
              <li><span>✓</span> Quarto mobilado e pronto a usar</li>
            </ul>
            <a class="cta-secondary" href={bookingUrl} data-booking>Consultar disponibilidade <span>→</span></a>
          </div>
        </div>
      </section>

      <section class="section faq-section">
        <div class="landing-container faq-wrap">
          <div class="faq-intro">
            <span class="eyebrow">SEM LETRAS PEQUENAS ESCONDIDAS</span>
            <h2>Antes de reservar.</h2>
            <p>O essencial para perceberes se esta opção faz sentido para ti.</p>
          </div>
          <div class="faq-list">
            <details open>
              <summary>O que está incluído no valor mensal?</summary>
              <p>A Tribera indica que eletricidade, água, aquecimento e Wi-Fi estão incluídos no valor mensal. O acesso às principais áreas comuns da residência, incluindo ginásio, também está incluído.</p>
            </details>
            <details>
              <summary>Qual é a diferença entre o Duo Apartment e o Studio?</summary>
              <p>No Duo Apartment tens o teu próprio quarto e partilhas cozinha, casa de banho e zona de refeições com outra pessoa. No Studio tens casa de banho privativa e minicozinha no teu próprio espaço.</p>
            </details>
            <details>
              <summary>Como funciona a vantagem dos 80 €?</summary>
              <p>No momento da reserva, introduz o promocode <strong>{promoCode}</strong>. Em vez de pagar inicialmente 230,00 € pela reserva, pagas apenas 80,00 €. As restantes condições e pagamentos da estadia são confirmados diretamente pela Tribera.</p>
            </details>
            <details>
              <summary>Os preços desta página são garantidos?</summary>
              <p>Não. Mostramos os preços base anunciados pela Tribera para ajudar a comparar as opções. A disponibilidade e o preço final dependem das datas, duração da estadia e condições em vigor no momento em que fazes a reserva.</p>
            </details>
            <details>
              <summary>Quem gere a reserva e o contrato?</summary>
              <p>A reserva, contrato, pagamentos e estadia são geridos diretamente pela Tribera. O Guia do Proprietário ajuda a apresentar e encaminhar a opção, mas não é o prestador do alojamento.</p>
            </details>
          </div>
        </div>
      </section>

      <section class="final-cta-section">
        <div class="final-bg" aria-hidden="true"></div>
        <div class="landing-container final-cta-content">
          <span class="eyebrow light">TRIBERA · LISBON OLAIAS</span>
          <h2>Se as Olaias fazem sentido, o próximo passo demora dois minutos.</h2>
          <p>Vê as datas disponíveis, confirma o preço para a tua estadia e decide com toda a informação à frente.</p>
          <div class="final-price"><span>Preços base desde</span><strong>819 €<small>/mês</small></strong><em>+ despesas incluídas</em></div>
          <a class="cta-primary large" href={bookingUrl} data-booking>Ver disponibilidade e reservar <span>→</span></a>
          <div class="final-promocode"><span>PROMOCODE</span><strong>{promoCode}</strong><small>230,00 € → 80,00 € no valor inicial da reserva</small></div>
          <p class="final-note">*Introduz o promocode <strong>{promoCode}</strong> no momento da reserva. Confirma as condições finais antes do pagamento.</p>
        </div>
      </section>

      <section class="disclosure-section">
        <div class="landing-container disclosure-wrap">
          <p><strong>Transparência:</strong> esta página apresenta uma solução de um parceiro do Guia do Proprietário. Se reservares através desta parceria e efetuares check-in, o Guia do Proprietário poderá receber uma comissão da Tribera. Isso não aumenta o preço que pagas.</p>
          <p>Informação sobre preços, características e condições baseada na informação publicada pela Tribera. Confirma sempre a informação atual no momento da reserva.</p>
          <div class="disclosure-links"><a href="/parceiros/">Lista de Parceiros</a><a href="/privacidade/">Privacidade</a><a href="/termos/">Termos</a><a href={triberaPage} target="_blank" rel="noopener noreferrer">Site oficial da Tribera</a></div>
        </div>
      </section>
    </main>

    <div class="mobile-sticky" aria-label="Ação de reserva">
      <div><span>Desde</span><strong>819 €<small>/mês</small></strong><em>GUIAPRO_D2027 · reserva 80 €</em></div>
      <a href={bookingUrl} data-booking>Reservar</a>
    </div>

    <CookieConsent />

    <script is:inline>
      (() => {
        const inbound = new URLSearchParams(window.location.search);
        const campaignKeys = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "fbclid", "gclid"];
        document.querySelectorAll("a[data-booking]").forEach((element) => {
          if (!(element instanceof HTMLAnchorElement)) return;
          try {
            const target = new URL(element.href);
            campaignKeys.forEach((key) => {
              const value = inbound.get(key);
              if (value) target.searchParams.set(`gp_${key}`, value);
            });
            element.href = target.toString();
          } catch (_) {
            // Mantém o href original se o browser não conseguir processar o URL.
          }
        });
      })();
    </script>

    <style>
      :global(html) { scroll-behavior: smooth; }
      :global(body.tribera-landing) { margin: 0; background: #f7f4ed; color: #152d31; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
      :global(.tribera-landing *) { box-sizing: border-box; }
      :global(.tribera-landing a) { color: inherit; }
      .landing-container { width: min(1180px, calc(100% - 40px)); margin: 0 auto; }
      .promo-strip { background: #f2bd57; color: #102f33; padding: 10px 20px; text-align: center; font-size: 13px; line-height: 1.45; position: relative; z-index: 30; }
      .promo-strip strong { font-weight: 900; }
      .promo-strip span { display: inline-block; margin-left: 6px; padding: 4px 9px; border-radius: 7px; background: #102f33; color: #fff; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-weight: 900; letter-spacing: .04em; }
      .landing-header { height: 76px; padding: 0 max(24px, calc((100vw - 1180px) / 2)); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; background: rgba(247, 244, 237, .96); border-bottom: 1px solid rgba(21, 45, 49, .12); position: relative; z-index: 20; }
      .landing-brand { display: inline-flex; align-items: center; gap: 11px; font-weight: 750; text-decoration: none; letter-spacing: -.02em; width: max-content; }
      .brand-mark { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 8px; background: #153e43; color: #fff; font-family: Georgia, serif; font-weight: 800; }
      .header-partner { text-align: center; display: flex; flex-direction: column; line-height: 1.2; }
      .header-partner span { font-size: 10px; letter-spacing: .16em; font-weight: 800; color: #6f7c78; }
      .header-partner strong { font-size: 13px; margin-top: 4px; }
      .header-cta { justify-self: end; text-decoration: none; background: #f47b48; color: #112f33 !important; font-size: 14px; font-weight: 800; padding: 12px 18px; border-radius: 999px; transition: transform .2s ease, box-shadow .2s ease; }
      .header-cta:hover { transform: translateY(-1px); box-shadow: 0 8px 20px rgba(244, 123, 72, .22); }

      .hero-section { min-height: 720px; position: relative; display: flex; overflow: hidden; background: #102f33; }
      .hero-photo { position: absolute; inset: 0 0 0 42%; background-image: url("https://triberaliving.com/wp-content/uploads/2025/10/Milestone-Olaias-11.jpg"); background-size: cover; background-position: center; }
