---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import Newsletter from "../components/Newsletter.astro";
import ProximosPrazos from "../components/ProximosPrazos.astro";
import { formatarData, NEWSLETTER_ATIVA, pilares } from "../config";
import { obterImagensArtigo } from "../lib/imagens-artigos";

const todosArtigos = await getCollection("artigos", ({ data }) => !data.rascunho);
const artigos = todosArtigos
  .filter((artigo) => artigo.data.destaque && artigo.data.nivel === "essencial")
  .sort((a, b) => b.data.revisto.valueOf() - a.data.revisto.valueOf());
const artigosRecentes = [...todosArtigos]
  .sort((a, b) => {
    const diferencaPublicacao = b.data.publicado.valueOf() - a.data.publicado.valueOf();
    if (diferencaPublicacao !== 0) return diferencaPublicacao;

    return a.data.titulo.localeCompare(b.data.titulo, "pt");
  })
  .slice(0, 8);
const nomesPilares = new Map(pilares.map((pilar) => [pilar.slug, pilar.nome]));
const notas = (await getCollection("notas")).sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf());
const notaRecente = notas[0];
const pilarCasa = pilares.find((pilar) => pilar.slug === "casa")!;
const situacoes = [
  { titulo: "Vou vender a casa.", url: "/vender/", imagem: "situacao-vender", alt: "Casa portuguesa com placa de venda" },
  { titulo: "Quanto vou pagar de IMI?", url: "/simuladores/imi/", imagem: "situacao-imi", alt: "Casa portuguesa com calendário e moeda de euro" },
  { titulo: "Sou senhorio.", url: "/arrendar/", imagem: "situacao-senhorio", alt: "Entrada de casa com chave e contrato de arrendamento" },
  // TODO: ligar a conteúdo próprio de heranças quando existir.
  { titulo: "Herdei uma casa.", url: "/vender/", imagem: "situacao-heranca", alt: "Casa portuguesa envolvida por um laço de herança" },
  { titulo: "Vivo em condomínio.", url: "/condominio/", imagem: "situacao-condominio", alt: "Prédio de condomínio português com varandas" },
  { titulo: "Quanto vale a minha casa?", url: "/simuladores/valor-liquido-venda/", imagem: "situacao-valor", alt: "Casa portuguesa com etiqueta de valor" }
];
const perguntasDoDia = [
  { pergunta: "Quanto custa pintar a casa?", artigo: "quanto-custa-pintar-casa" },
  { pergunta: "De quem é a culpa de uma infiltração?", artigo: "quem-paga-infiltracao" },
  { pergunta: "Como baixar a conta da luz?", artigo: "como-baixar-conta-luz" },
  { pergunta: "O que fazer com o bolor?", artigo: "o-que-fazer-com-bolor" },
  { pergunta: "O que fazer com um vizinho barulhento?", artigo: "vizinho-barulhento" },
  { pergunta: "Quanto custa uma remodelação?", artigo: "quanto-custa-remodelacao" }
].flatMap((item) => {
  const artigo = todosArtigos.find((entrada) => entrada.id === item.artigo && entrada.data.pilar === "casa");
  return artigo ? [{ ...item, artigo }] : [];
});
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-visual">
      <picture class="hero-picture">
        <source media="(max-width: 768px)" srcset="/imagens/hero-home-mobile.avif" type="image/avif" />
        <source media="(max-width: 768px)" srcset="/imagens/hero-home-mobile.webp" type="image/webp" />
        <source srcset="/imagens/hero-home.avif" type="image/avif" />
        <img src="/imagens/hero-home.webp" width="1600" height="900" fetchpriority="high" alt="Rua de bairro portuguesa com casas de azulejo, varandas e telhados vermelhos" />
      </picture>
      <div class="hero-content">
        <p class="eyebrow">GUIA DO PROPRIETÁRIO</p>
        <h1>Tudo o que precisa de saber sobre a sua casa, num só sítio.</h1>
        <p class="hero-copy">Impostos, obras, arrendamento, condomínio, venda: ...tudo o que dá trabalho numa casa, explicado.</p>
        <div class="hero-actions">
          <a class="button" href="#perguntas-dia">Começar pelas dúvidas mais comuns</a>
          <a class="button secondary" href="#este-mes">Ver os prazos deste mês</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section recent-articles-section" aria-labelledby="mais-recentes-titulo">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">ACABADO DE PUBLICAR</p>
        <h2 id="mais-recentes-titulo">Mais recentes</h2>
        <p>Os últimos artigos do Guia do Proprietário, de todos os temas.</p>
      </div>
      <div class="recent-articles-grid">
        {artigosRecentes.map((artigo) => (
          <article class="recent-article-card">
            <a href={`/${artigo.data.pilar}/${artigo.id}/`}>
              <picture>
                <source srcset={obterImagensArtigo(artigo).avif} type="image/avif" />
                <img
                  src={obterImagensArtigo(artigo).webp}
                  alt=""
                  width="1200"
                  height="675"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <div>
                <p>{nomesPilares.get(artigo.data.pilar) ?? artigo.data.pilar}</p>
                <h3>{artigo.data.titulo}</h3>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section daily-questions-section" id="perguntas-dia">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">O DIA A DIA DA CASA</p>
        <h2>Comece pela dúvida que o trouxe aqui.</h2>
        <p>As perguntas que todos os proprietários fazem mais cedo ou mais tarde.</p>
      </div>
      <div class="daily-questions-grid">
        {perguntasDoDia.map((item) => (
          <a class="daily-question-card" href={`/casa/${item.artigo.id}/`}>
            <picture>
              <source srcset={obterImagensArtigo(item.artigo).avif} type="image/avif" />
              <img src={obterImagensArtigo(item.artigo).webp} alt={pilarCasa.alt} width="1200" height="675" loading="lazy" />
            </picture>
            <h3>{item.pergunta}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="section-heading"><h2>A sua situação</h2><p>Está a tratar de algo maior? Escolha o ponto de partida.</p></div>
      <div class="situation-grid">
        {situacoes.map((situacao) => (
          <a class="situation-card" href={situacao.url}>
            <picture>
              <source srcset={`/imagens/${situacao.imagem}.avif`} type="image/avif" />
              <img src={`/imagens/${situacao.imagem}.webp`} alt={situacao.alt} width="640" height="360" loading="lazy" />
            </picture>
            <h3>{situacao.titulo}</h3>
            <span>Ver o próximo passo</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">PARA LER COM CALMA</p><h2>Guias que explicam tudo, passo a passo.</h2></div>
      <div class="article-grid">{artigos.map((artigo) => <ArticleCard artigo={artigo} />)}</div>
    </div>
  </section>

  <section class="section current-month" id="este-mes">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">Calendário</p><h2>Este mês</h2></div>
      <div class="current-grid">
        <ProximosPrazos dataBuild={new Date()} />
        <article class="latest-note">
          <p class="eyebrow">Última novidade</p>
          <time datetime={notaRecente.data.data.toISOString()}>{formatarData(notaRecente.data.data)}</time>
          <h3><a href={`/novidades/${notaRecente.id}/`}>{notaRecente.data.titulo}</a></h3>
          <p>{notaRecente.data.resumo}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="simuladores">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">Ferramentas abertas</p><h2>Faça uma simulação sem custos!</h2></div>
      <div class="tools-grid">
        <a class="tool-card" href="/simuladores/imi/"><h3>Simulador de IMI</h3><p>Estime o imposto anual a partir do valor patrimonial e da taxa municipal.</p></a>
        <a class="tool-card" href="/simuladores/valor-liquido-venda/"><h3>Valor líquido da venda</h3><p>Veja quanto pode sobrar depois dos principais custos.</p></a>
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">Atualidade</p><h2>Novidades</h2></div>
      <div class="notes-grid">
        {notas.slice(0, 3).map((nota) => (
          <article>
            <time datetime={nota.data.data.toISOString()}>{formatarData(nota.data.data)}</time>
            <h3><a href={`/novidades/${nota.id}/`}>{nota.data.titulo}</a></h3>
            <p>{nota.data.resumo}</p>
          </article>
        ))}
      </div>
      <p class="section-link"><a href="/novidades/">Todas as novidades</a></p>
    </div>
  </section>
  {NEWSLETTER_ATIVA && <Newsletter />}
</BaseLayout>
