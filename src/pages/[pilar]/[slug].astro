---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Newsletter from "../../components/Newsletter.astro";
import ProximosPrazos from "../../components/ProximosPrazos.astro";
import Custos from "../../components/Custos.astro";
import { avisos, formatarData, pilares, site } from "../../config";

export async function getStaticPaths() {
  const artigos = await getCollection("artigos", ({ data }) => !data.rascunho);
  return artigos.map((artigo) => ({ params: { pilar: artigo.data.pilar, slug: artigo.id }, props: { artigo } }));
}
const { artigo } = Astro.props;
const { Content } = await render(artigo);
const pilar = pilares.find((item) => item.slug === artigo.data.pilar)!;
const imagemCapa = artigo.data.imagem_capa === "auto" ? pilar.imagemWebp : artigo.data.imagem_capa;
const imagemCapaAvif = artigo.data.imagem_capa === "auto" ? pilar.imagemAvif : artigo.data.imagem_capa.replace(/\.(webp|png|jpe?g)$/i, ".avif");
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: artigo.data.titulo,
  description: artigo.data.descricao,
  datePublished: artigo.data.publicado.toISOString(),
  dateModified: artigo.data.revisto.toISOString(),
  author: { "@type": "Organization", name: "Redação Guia do Proprietário" },
  publisher: { "@type": "Organization", name: site.nome, url: site.dominio },
  mainEntityOfPage: new URL(Astro.url.pathname, site.dominio).toString()
};
const faqSchema = artigo.data.perguntas_rapidas ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: artigo.data.perguntas_rapidas.map((item) => ({
    "@type": "Question",
    name: item.pergunta,
    acceptedAnswer: { "@type": "Answer", text: item.resposta }
  }))
} : null;
const artigoPar = artigo.data.par
  ? (await getCollection("artigos", ({ data }) => !data.rascunho)).find((item) => item.id === artigo.data.par)
  : undefined;
---
<BaseLayout titulo={artigo.data.titulo} descricao={artigo.data.descricao} tipo="article">
  <article class="article-layout">
    <Breadcrumbs itens={[{ nome: "Início", url: "/" }, { nome: pilar.nome, url: `/${pilar.slug}/` }, { nome: artigo.data.titulo }]} />
    <header class="article-header"><picture><source srcset={imagemCapaAvif} type="image/avif" /><img class="article-illustration" src={imagemCapa} alt={pilar.alt} width="1200" height="675" loading="lazy" /></picture><p class="eyebrow">{pilar.nome}{artigo.data.nivel === "detalhado" && <span class="level-label">Versão completa</span>}</p><h1>{artigo.data.titulo}</h1><p class="article-description">{artigo.data.descricao}</p><p class="article-meta">Atualizado a {formatarData(artigo.data.revisto)} · Redação Guia do Proprietário</p></header>
    <aside class="quick-answer"><h2>{artigo.data.nivel === "essencial" ? "Em duas linhas" : "Resposta rápida"}</h2><p>{artigo.data.resposta_rapida}</p></aside>
    {artigo.data.exemplo && <aside class="number-example"><h2>{artigo.data.exemplo.titulo}</h2><p>{artigo.data.exemplo.texto}</p></aside>}
    {artigo.data.aviso !== "nenhum" && <aside class="notice">{avisos[artigo.data.aviso]}</aside>}
    {artigo.data.custos && <Custos titulo={artigo.data.custos.titulo} itens={artigo.data.custos.itens} />}
    <div class="article-body"><Content /></div>
    {artigo.data.perguntas_rapidas && <section class="quick-questions"><h2>Perguntas rápidas</h2>{artigo.data.perguntas_rapidas.map((item) => <details><summary>{item.pergunta}</summary><p>{item.resposta}</p></details>)}</section>}
    {artigoPar && <aside class="paired-article"><p>{artigo.data.nivel === "essencial" ? "Prefere a versão completa?" : "Prefere a versão simples?"}</p><a href={`/${artigoPar.data.pilar}/${artigoPar.id}/`}>{artigoPar.data.titulo}</a></aside>}
    {artigo.data.pilar === "impostos" && <ProximosPrazos dataBuild={new Date()} quantidade={3} compacto />}
    <section class="sources"><h2>Fontes</h2><ul>{artigo.data.fontes.map((fonte) => <li><a href={fonte.url} rel="noreferrer">{fonte.nome}</a></li>)}</ul></section>
    <p><a href="/metodologia/">Como produzimos e atualizamos os conteúdos</a></p>
  </article>
  <Newsletter />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</BaseLayout>
