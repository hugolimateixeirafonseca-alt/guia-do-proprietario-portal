---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Newsletter from "../../components/Newsletter.astro";
import { pilares } from "../../config";

export function getStaticPaths() {
  return pilares.map((pilar) => ({ params: { pilar: pilar.slug }, props: { pilar } }));
}
const { pilar } = Astro.props;
const artigos = (await getCollection("artigos", ({ data }) => data.pilar === pilar.slug && !data.rascunho)).sort((a, b) => {
  if (a.data.nivel !== b.data.nivel) return a.data.nivel === "essencial" ? -1 : 1;
  return b.data.revisto.valueOf() - a.data.revisto.valueOf();
});
---
<BaseLayout titulo={pilar.nome} descricao={pilar.descricao}>
  <section class="page-hero"><div class="container pillar-hero"><div><Breadcrumbs itens={[{ nome: "Início", url: "/" }, { nome: pilar.nome }]} /><p class="eyebrow">Guia por tema</p><h1>{pilar.nome}</h1><p>{pilar.descricao}</p></div><picture><source srcset={pilar.imagemAvif} type="image/avif" /><img src={pilar.imagemWebp} alt={pilar.alt} width="1200" height="675" loading="lazy" /></picture></div></section>
  <section class="section"><div class="container"><div class="article-grid">{artigos.map((artigo) => <ArticleCard artigo={artigo} />)}</div></div></section>
  <Newsletter />
</BaseLayout>
