---
import Squeeze from "../../layouts/Squeeze.astro";
---

<Squeeze
  titulo="Pagamento recebido | Verificação de Anúncio"
  descricao="Confirmação do pagamento da Verificação de Anúncio."
  imagemOg="/og/verificacao-anuncio/index.png"
  robots="noindex,nofollow"
>
  <section class="confirmation">
    <div class="card">
      <span class="success" aria-hidden="true">✓</span>
      <p class="eyebrow">Pagamento recebido</p>
      <h1>O próximo passo chega ao seu email.</h1>
      <p>Estamos a confirmar o pagamento e a preparar a ligação privada onde poderá enviar as capturas do anúncio.</p>
      <div class="notice"><strong>Não feche o acesso ao seu email.</strong><span>A mensagem pode demorar alguns minutos. Verifique também a pasta de spam.</span></div>
      <a href="/verificacao-anuncio/">Voltar à Verificação de Anúncio</a>
    </div>
  </section>
</Squeeze>

<style>
  :global(*){box-sizing:border-box}:global(body){margin:0;background:linear-gradient(145deg,#062f2c,#0a5146);color:#123b34;font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}.confirmation{display:grid;min-height:100vh;padding:32px;place-items:center}.card{width:min(640px,100%);padding:55px;border-radius:25px;background:#fff;box-shadow:0 35px 100px rgba(0,20,18,.35);text-align:center}.success{display:grid;width:68px;height:68px;margin:0 auto 24px;place-items:center;border-radius:50%;background:#d9ff72;color:#087058;font-size:1.7rem;font-weight:950}.eyebrow{margin:0 0 12px;color:#0a7c61;font-size:.72rem;font-weight:950;letter-spacing:.16em;text-transform:uppercase}.card h1{margin:0;font-size:clamp(2.3rem,6vw,4rem);line-height:.98;letter-spacing:-.055em}.card>p:not(.eyebrow){margin:24px auto 0;color:#60766f;font-size:1rem;line-height:1.65}.notice{display:grid;gap:5px;margin:30px 0;padding:18px;border-radius:13px;background:#f0f7f3}.notice span{color:#667a73;font-size:.78rem;line-height:1.5}.card a{display:inline-flex;min-height:50px;padding:0 20px;align-items:center;border-radius:10px;background:#0a7b60;color:#fff;text-decoration:none;font-weight:900}@media(max-width:580px){.confirmation{padding:18px}.card{padding:38px 22px}.card h1{font-size:2.7rem}}
</style>

