---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { formatarData } from "../../config";

export async function getStaticPaths() {
  const notas = await getCollection("notas");
  return notas.map((nota) => ({ params: { slug: nota.id }, props: { nota } }));
}

const { nota } = Astro.props;
const { Content } = await render(nota);
const relacionados = nota.data.pilar
  ? (await getCollection("artigos", ({ data }) => data.pilar === nota.data.pilar && !data.rascunho))
      .sort((a, b) => b.data.revisto.valueOf() - a.data.revisto.valueOf())
      .slice(0, 3)
  : [];
const imagemOg = new URL(`/social/noticias/${nota.id}.png`, Astro.url.origin).toString();
---
<BaseLayout
  titulo={nota.data.titulo}
  descricao={nota.data.resumo}
  tipo="article"
  imagemOg={imagemOg}
>
  <article class="article-layout note-page news-note-page">
    <Breadcrumbs itens={[{ nome: "Início", url: "/" }, { nome: "Novidades", url: "/novidades/" }, { nome: nota.data.titulo }]} />
    <header class="article-header news-note-header">
      <p class="eyebrow">Novidade</p>
      <h1>{nota.data.titulo}</h1>
      <p class="article-meta">Publicado a {formatarData(nota.data.data)}</p>
    </header>

    <div class="article-body news-note-body"><Content /></div>

    <section class="sources news-source">
      <p class="eyebrow">Fonte original</p>
      <h2>{nota.data.fonte_nome}</h2>
      <p>Esta página resume e organiza os factos verificados na publicação original. Consulte a fonte para o contexto integral.</p>
      <a class="button" href={nota.data.fonte_url} target="_blank" rel="noopener noreferrer">Ler a notícia original →</a>
    </section>

    {relacionados.length > 0 && (
      <section class="news-related">
        <div class="section-heading">
          <p class="eyebrow">Continue no Guia</p>
          <h2>Também pode interessar</h2>
          <p>Guias práticos do mesmo tema para aprofundar o assunto.</p>
        </div>
        <div class="article-grid news-related-grid">
          {relacionados.map((artigo) => <ArticleCard artigo={artigo} />)}
        </div>
      </section>
    )}
  </article>

  <style>
    .news-note-page { padding-bottom: 18px; }
    .news-note-header { max-width: 900px; }
    .news-note-body { max-width: 820px; }
    .news-note-body :global(> p:first-child) { margin-top: 0; color: var(--ink); font-size: 19px; line-height: 1.72; }
    .news-note-body :global(h2) { margin-top: 46px; margin-bottom: 16px; font-size: clamp(27px, 3vw, 38px); }
    .news-note-body :global(ul) { margin: 0; padding: 0; display: grid; gap: 10px; list-style: none; }
    .news-note-body :global(li) { position: relative; padding: 15px 18px 15px 46px; background: var(--cream); border-left: 4px solid var(--green); }
    .news-note-body :global(li::before) { content: "✓"; position: absolute; left: 18px; top: 14px; color: var(--green); font-weight: 900; }
    .news-source { max-width: 820px; margin-top: 54px; padding: 28px; background: var(--cream); border: 1px solid var(--line); }
    .news-source h2 { margin: 0 0 9px; font-size: 25px; }
    .news-source p:not(.eyebrow) { margin: 0 0 20px; color: var(--muted); }
    .news-related { margin-top: 72px; padding-top: 48px; border-top: 1px solid var(--line); }
    .news-related .section-heading { margin-bottom: 25px; }
    .news-related .section-heading h2 { margin-top: 0; }
    .news-related-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    @media (max-width: 820px) {
      .news-related-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>