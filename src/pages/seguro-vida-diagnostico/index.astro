---
import Squeeze from "../../layouts/Squeeze.astro";
import { SEGURO_VIDA_DESTINOS } from "../../data/seguro-vida";
const perguntas = [
  { titulo: "Onde contratou o seu seguro de vida?", opcoes: ["No banco onde tenho o crédito", "Fora do banco", "Não tenho a certeza"] },
  { titulo: "Quando foi a última vez que comparou o preço do seguro?", opcoes: ["Nunca comparei", "Há mais de 3 anos", "Nos últimos 3 anos", "Não me lembro"] },
  { titulo: "O que gostaria de perceber?", opcoes: ["Se consigo pagar menos todos os meses", "Se posso mudar sem prejudicar o crédito", "Se tenho uma proteção melhor pelo mesmo preço", "Quero simplesmente comparar"] },
];
const destino = SEGURO_VIDA_DESTINOS.landing + "?source=seguro-vida-diagnostico";
---
<Squeeze titulo="Vale a pena comparar o seu seguro de vida? | Guia do Proprietário" descricao="Responda a 3 perguntas rápidas sobre o seguro de vida do crédito habitação. Sem dados pessoais." imagemOg="/imagens/campanhas/seguro-vida-casa-ilustrada.webp" robots="noindex,follow">
  <div class="diagnostico" data-diagnostico>
    <header class="marca">Guia do Proprietário</header>
    <div class="etapas">
      <section data-etapa="0" aria-labelledby="inicio-titulo">
        <p class="etiqueta">Seguro de vida do crédito habitação</p>
        <h1 id="inicio-titulo" tabindex="-1">Pode estar a pagar <em>mais do que precisa.</em></h1>
        <p class="intro">Responda a 3 perguntas rápidas e veja se faz sentido comparar.</p>
        <button class="principal" type="button" data-comecar hidden>Começar <span aria-hidden="true">→</span></button>
        <p class="nota">Menos de 30 segundos. Sem pedir dados pessoais.</p>
        <noscript><a class="principal" href={destino} rel="sponsored noopener">Ver quanto posso poupar →</a></noscript>
      </section>
      {perguntas.map((pergunta, index) => <section data-etapa={index + 1} hidden aria-labelledby={`pergunta-${index}`}>
        <div class="progresso"><p class="etiqueta">{index + 1} de 3</p><span class="barras" aria-hidden="true">{perguntas.map((_, i) => <i class:list={{feito: i <= index}} />)}</span></div>
        <h2 id={`pergunta-${index}`} tabindex="-1">{pergunta.titulo}</h2>
        <div class="opcoes">{pergunta.opcoes.map(opcao => <button type="button" data-resposta>{opcao}<span aria-hidden="true">→</span></button>)}</div>
        <button class="voltar" type="button" data-voltar>← Voltar</button>
      </section>)}
      <section data-etapa="4" hidden aria-labelledby="resultado-titulo">
        <p class="etiqueta">Próximo passo</p>
        <h2 id="resultado-titulo" tabindex="-1">Vale a pena <em>comparar.</em></h2>
        <p class="intro">O seguro associado ao crédito habitação não tem de ficar igual durante toda a duração do empréstimo.</p>
        <p class="apoio">Uma simulação permite perceber se existe uma alternativa mais vantajosa para o seu caso.</p>
        <a class="principal" href={destino} rel="sponsored noopener" data-seguro-link>Ver quanto posso poupar <span aria-hidden="true">→</span></a>
        <p class="nota">Simulação gratuita e sem compromisso, no site do parceiro.</p>
        <button class="voltar" type="button" data-voltar>← Voltar</button>
      </section>
    </div>
    <footer><a href="/privacidade/">Privacidade</a><a href="#cookie-settings" data-cookie-settings>Definições de cookies</a></footer>
  </div>
</Squeeze>
<script>
  import { prepararLinksSeguroVida } from "../../lib/seguro-vida-links";
  prepararLinksSeguroVida();
  const raiz = document.querySelector<HTMLElement>("[data-diagnostico]");
  if (raiz) {
    const etapas = [...raiz.querySelectorAll<HTMLElement>("[data-etapa]")];
    let atual = 0;
    const mostrar = (indice: number) => {
      atual = Math.max(0, Math.min(etapas.length - 1, indice));
      etapas.forEach((etapa, i) => { etapa.hidden = i !== atual; });
      etapas[atual].querySelector<HTMLElement>("h1, h2")?.focus();
    };
    const comecar = raiz.querySelector<HTMLButtonElement>("[data-comecar]");
    if (comecar) comecar.hidden = false;
    raiz.addEventListener("click", (event) => {
      const alvo = event.target;
      if (!(alvo instanceof Element)) return;
      const botao = alvo.closest<HTMLButtonElement>("button");
      if (!botao || !etapas[atual].contains(botao)) return;
      if (botao.hasAttribute("data-comecar") || botao.hasAttribute("data-resposta")) mostrar(atual + 1);
      else if (botao.hasAttribute("data-voltar")) mostrar(atual - 1);
    });
  }
</script>
<style>
  :global(body){margin:0;background:#f5f2e9;color:#183b34;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
  .diagnostico{box-sizing:border-box;width:min(100%,680px);min-height:100svh;margin:auto;padding:28px 28px 20px;display:flex;flex-direction:column}
  .diagnostico *{box-sizing:border-box}.diagnostico [hidden]{display:none!important}
  .marca{font-size:15px;font-weight:700;letter-spacing:-.3px}.etapas{flex:1;display:grid;align-items:center;padding:48px 0}.etapas section{width:100%}
  .etiqueta{margin:0 0 20px;color:#3c6d5d;font-size:12px;font-weight:750;letter-spacing:.1em;text-transform:uppercase}
  h1,h2{font-size:clamp(31px,5vw,46px);line-height:1.12;letter-spacing:-.045em;margin:0 0 24px;font-weight:750}h1:focus,h2:focus{outline:none}em{font-style:normal;color:#3b7860}
  .intro{font-size:19px;line-height:1.55;margin:0 0 24px;max-width:48ch}.apoio{font-size:17px;line-height:1.55;margin:0 0 30px;color:#4d6056}
  button,a{font:inherit}button{cursor:pointer}.principal{display:flex;align-items:center;justify-content:center;gap:18px;width:100%;min-height:62px;padding:17px 20px;border:0;border-radius:9px;background:#215e4e;color:white;font-size:19px;font-weight:750;text-decoration:none;line-height:1.25}.principal:hover{background:#174737}.principal span{font-size:25px}
  .nota{font-size:13px;line-height:1.5;color:#58665e;text-align:center;margin:14px 0 0}.progresso{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px}.progresso .etiqueta{margin:0}.barras{display:flex;gap:6px}.barras i{width:34px;height:4px;background:#d8dfd4;border-radius:4px}.barras .feito{background:#215e4e}
  .opcoes{display:grid;gap:11px}.opcoes button{display:flex;align-items:center;justify-content:space-between;gap:16px;width:100%;min-height:66px;padding:17px 20px;border:1px solid #c7d3c7;border-radius:9px;background:#fffefa;color:#183b34;text-align:left;font-size:17px;font-weight:600;line-height:1.35}.opcoes button span{color:#3b7860}.opcoes button:hover{border-color:#215e4e;background:#eaf0e6}.voltar{border:0;background:none;color:#53675b;padding:12px 0;margin-top:16px;font-size:14px}
  button:focus-visible,a:focus-visible{outline:3px solid #b56b29;outline-offset:4px}footer{display:flex;justify-content:center;flex-wrap:wrap;gap:20px;font-size:12px;color:#647166}footer a{color:inherit;text-underline-offset:3px}
  @media(max-width:480px){.diagnostico{padding:23px 20px 18px}.etapas{padding:34px 0}h1,h2{font-size:34px}.intro{font-size:17px}.opcoes button{font-size:16px;padding:16px;min-height:64px}.principal{font-size:17px}.marca{font-size:14px}}
</style>
