---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { pilares } from "../../config";
import { organizarArtigosRecentes } from "../../lib/artigos";

const artigos = organizarArtigosRecentes(await getCollection("artigos", ({ data }) => !data.rascunho));
---
<BaseLayout
  titulo="Todos os artigos"
  descricao="Consulte todos os artigos do Guia do Proprietário sobre casa, impostos, arrendamento, condomínio e venda."
>
  <section class="hero article-archive-intro">
    <div class="container">
      <p class="eyebrow">GUIA DO PROPRIETÁRIO</p>
      <h1>Todos os artigos</h1>
      <p class="hero-copy">Encontre respostas práticas para cuidar da casa, tomar decisões e cumprir obrigações sem perder tempo.</p>
      <nav class="topic-links" aria-label="Explorar artigos por tema">
        {pilares.map((pilar) => <a href={`/${pilar.slug}/`}>{pilar.nome}</a>)}
        <a href="/limpeza/">Limpeza</a>
      </nav>
    </div>
  </section>

  <section class="section" aria-labelledby="arquivo-artigos-titulo">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">ARQUIVO COMPLETO</p>
        <h2 id="arquivo-artigos-titulo">Explore os artigos mais recentes</h2>
        <p>{artigos.length} artigos publicados. Explore as novidades sobre casa, obras, impostos, arrendamento e venda.</p>
      </div>
      <div class="article-grid">
        {artigos.map((artigo) => <ArticleCard artigo={artigo} />)}
      </div>
    </div>
  </section>
</BaseLayout>
